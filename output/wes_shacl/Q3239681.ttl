@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/ScientificTheoryShape> a sh:NodeShape ;
    rdfs:label "scientific theory"@en ;
    sh:name "scientific theory"@en ;
    sh:property [ sh:name "has characteristic"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1552 ],
        [ sh:name "described by source"@en ;
            sh:or ( [ sh:class wd:Q3331189 ] [ sh:class wd:Q13442814 ] ) ;
            sh:path wdt:P1343 ],
        [ sh:class wd:Q16695773 ;
            sh:maxCount 1 ;
            sh:name "maintained by WikiProject"@en ;
            sh:path wdt:P6104 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:name "studied by"@en ;
            sh:or ( [ sh:class wd:Q336 ] [ sh:class wd:Q11862829 ] [ sh:class wd:Q1047113 ] [ sh:class wd:Q2465832 ] ) ;
            sh:path wdt:P2579 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "time of discovery or invention"@en ;
            sh:path wdt:P575 ],
        [ sh:class wd:Q16695773 ;
            sh:name "on focus list of Wikimedia project"@en ;
            sh:path wdt:P5008 ],
        [ sh:name "part of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P361 ],
        [ sh:name "named after"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P138 ],
        [ sh:maxCount 1 ;
            sh:name "Stack Exchange tag"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1482 ],
        [ sh:name "main subject"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P921 ],
        [ sh:name "facet of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1269 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:class wd:Q5 ;
            sh:name "discoverer or inventor"@en ;
            sh:path wdt:P61 ],
        [ sh:maxCount 1 ;
            sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ] ;
    sh:targetClass wd:Q3239681 .

wd:Q1047113 rdfs:label "field of study"@en .

wd:Q11862829 rdfs:label "academic discipline"@en .

wd:Q13442814 rdfs:label "scholarly article"@en .

wd:Q2465832 rdfs:label "branch of science"@en .

wd:Q3239681 rdfs:label "scientific theory"@en .

wd:Q3331189 rdfs:label "version, edition or translation"@en .

wd:Q336 rdfs:label "science"@en .

wd:Q4167836 rdfs:label "Wikimedia category"@en .

wd:Q5 rdfs:label "human"@en .

wdt:P1269 rdfs:label "facet of"@en .

wdt:P1343 rdfs:label "described by source"@en .

wdt:P138 rdfs:label "named after"@en .

wdt:P1482 rdfs:label "Stack Exchange tag"@en .

wdt:P1552 rdfs:label "has characteristic"@en .

wdt:P1889 rdfs:label "different from"@en .

wdt:P2579 rdfs:label "studied by"@en .

wdt:P361 rdfs:label "part of"@en .

wdt:P373 rdfs:label "Commons category"@en .

wdt:P5008 rdfs:label "on focus list of Wikimedia project"@en .

wdt:P575 rdfs:label "time of discovery or invention"@en .

wdt:P61 rdfs:label "discoverer or inventor"@en .

wdt:P6104 rdfs:label "maintained by WikiProject"@en .

wdt:P910 rdfs:label "topic's main category"@en .

wdt:P921 rdfs:label "main subject"@en .

wd:Q16695773 rdfs:label "WikiProject"@en .

