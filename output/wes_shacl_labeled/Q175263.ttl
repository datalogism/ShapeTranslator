@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/DataStructureShape> a sh:NodeShape ;
    rdfs:label "data structure"@en ;
    sh:property [ sh:maxCount 1 ;
            sh:name "Stack Exchange tag"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1482 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "time of discovery or invention"@en ;
            sh:path wdt:P575 ],
        [ sh:class wd:Q16695773 ;
            sh:maxCount 1 ;
            sh:name "maintained by WikiProject"@en ;
            sh:path wdt:P6104 ],
        [ sh:maxCount 1 ;
            sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:name "has use"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P366 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:class wd:Q827335 ;
            sh:maxCount 1 ;
            sh:name "uses"@en ;
            sh:path wdt:P2283 ],
        [ sh:class wd:Q5 ;
            sh:name "discoverer or inventor"@en ;
            sh:path wdt:P61 ],
        [ sh:hasValue wd:Q13636890 ;
            sh:maxCount 1 ;
            sh:name "studied by"@en ;
            sh:path wdt:P2579 ],
        [ sh:maxCount 1 ;
            sh:name "described at URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P973 ] ;
    sh:targetClass wd:Q175263 .

