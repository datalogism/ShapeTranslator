@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/AcademicConferenceShape> a sh:NodeShape ;
    rdfs:label "academic conference"@en ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "start time"@en ;
            sh:path wdt:P580 ],
        [ sh:class wd:Q5 ;
            sh:name "participant"@en ;
            sh:path wdt:P710 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "short name"@en ;
            sh:path wdt:P1813 ],
        [ sh:class wd:Q5 ;
            sh:name "chairperson"@en ;
            sh:path wdt:P488 ],
        [ sh:class wd:Q5 ;
            sh:maxCount 1 ;
            sh:name "named after"@en ;
            sh:path wdt:P138 ],
        [ sh:class wd:Q2020153 ;
            sh:maxCount 1 ;
            sh:name "follows"@en ;
            sh:path wdt:P155 ],
        [ sh:maxCount 1 ;
            sh:name "publisher"@en ;
            sh:or ( [ sh:class wd:Q2085381 ] [ sh:class wd:Q4202064 ] ) ;
            sh:path wdt:P123 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:class wd:Q5 ;
            sh:name "speaker"@en ;
            sh:path wdt:P823 ],
        [ sh:datatype xsd:decimal ;
            sh:name "admission rate"@en ;
            sh:path wdt:P5822 ],
        [ sh:name "organizer"@en ;
            sh:or ( [ sh:class wd:Q2085381 ] [ sh:class wd:Q45400320 ] [ sh:class wd:Q43229 ] ) ;
            sh:path wdt:P664 ],
        [ sh:class wd:Q515 ;
            sh:maxCount 1 ;
            sh:name "location"@en ;
            sh:path wdt:P276 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "edition number"@en ;
            sh:path wdt:P393 ],
        [ sh:class wd:Q5 ;
            sh:name "has program committee member"@en ;
            sh:path wdt:P5804 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "title"@en ;
            sh:path wdt:P1476 ],
        [ sh:maxCount 1 ;
            sh:name "described at URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P973 ],
        [ sh:maxCount 1 ;
            sh:name "official website"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P856 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "event interval"@en ;
            sh:path wdt:P2257 ],
        [ sh:name "main subject"@en ;
            sh:or ( [ sh:class wd:Q11862829 ] [ sh:class wd:Q2267705 ] [ sh:class wd:Q4671286 ] ) ;
            sh:path wdt:P921 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "number of participants"@en ;
            sh:path wdt:P1132 ],
        [ sh:class wd:Q34770 ;
            sh:name "language used"@en ;
            sh:path wdt:P2936 ],
        [ sh:name "field of work"@en ;
            sh:or ( [ sh:class wd:Q11862829 ] [ sh:class wd:Q2267705 ] [ sh:class wd:Q4671286 ] ) ;
            sh:path wdt:P101 ],
        [ sh:class wd:Q2020153 ;
            sh:name "colocated with"@en ;
            sh:path wdt:P11633 ],
        [ sh:class wd:Q43229 ;
            sh:name "sponsor"@en ;
            sh:path wdt:P859 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "end time"@en ;
            sh:path wdt:P582 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "social media followers"@en ;
            sh:path wdt:P8687 ],
        [ sh:maxCount 1 ;
            sh:name "exact match"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P2888 ],
        [ sh:class wd:Q2020153 ;
            sh:maxCount 1 ;
            sh:name "followed by"@en ;
            sh:path wdt:P156 ],
        [ sh:maxCount 1 ;
            sh:name "part of the series"@en ;
            sh:or ( [ sh:class wd:Q47258130 ] [ sh:class wd:Q15900647 ] ) ;
            sh:path wdt:P179 ] ;
    sh:targetClass wd:Q2020153 .

