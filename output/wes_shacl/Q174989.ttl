@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/FileSystemShape> a sh:NodeShape ;
    rdfs:label "file system"@en ;
    sh:name "file system"@en ;
    sh:property [ sh:class wd:Q7397 ;
            sh:name "used by"@en ;
            sh:path wdt:P1535 ],
        [ sh:class wd:Q174989 ;
            sh:maxCount 1 ;
            sh:name "follows"@en ;
            sh:path wdt:P155 ],
        [ sh:class wd:Q77205602 ;
            sh:name "copyright license"@en ;
            sh:path wdt:P275 ],
        [ sh:datatype xsd:string ;
            sh:name "partition type identifier"@en ;
            sh:path wdt:P4654 ],
        [ sh:name "has use"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P366 ],
        [ sh:class wd:Q9143 ;
            sh:maxCount 1 ;
            sh:name "programmed in"@en ;
            sh:path wdt:P277 ],
        [ sh:maxCount 1 ;
            sh:name "Stack Exchange tag"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1482 ],
        [ sh:maxCount 1 ;
            sh:name "official website"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P856 ],
        [ sh:datatype xsd:string ;
            sh:name "software version identifier"@en ;
            sh:path wdt:P348 ],
        [ sh:class wd:Q174989 ;
            sh:maxCount 1 ;
            sh:name "based on"@en ;
            sh:path wdt:P144 ],
        [ sh:class wd:Q174989 ;
            sh:maxCount 1 ;
            sh:name "followed by"@en ;
            sh:path wdt:P156 ],
        [ sh:maxCount 1 ;
            sh:name "source code repository URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1324 ],
        [ sh:class wd:Q9135 ;
            sh:name "operating system"@en ;
            sh:path wdt:P306 ],
        [ sh:name "described at URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P973 ],
        [ sh:class wd:Q7397 ;
            sh:name "uses"@en ;
            sh:path wdt:P2283 ],
        [ sh:class wd:Q7397 ;
            sh:name "part of"@en ;
            sh:path wdt:P361 ],
        [ sh:class wd:Q174989 ;
            sh:maxCount 1 ;
            sh:name "replaced by"@en ;
            sh:path wdt:P1366 ],
        [ sh:hasValue wd:Q50423863 ;
            sh:maxCount 1 ;
            sh:name "copyright status"@en ;
            sh:path wdt:P6216 ],
        [ sh:name "developer"@en ;
            sh:or ( [ sh:class wd:Q5 ] [ sh:class wd:Q43229 ] [ sh:class wd:Q4830453 ] ) ;
            sh:path wdt:P178 ],
        [ sh:datatype xsd:dateTime ;
            sh:name "inception"@en ;
            sh:path wdt:P571 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ] ;
    sh:targetClass wd:Q174989 .

wd:Q43229 rdfs:label "organization"@en .

wd:Q4830453 rdfs:label "business"@en .

wd:Q5 rdfs:label "human"@en .

