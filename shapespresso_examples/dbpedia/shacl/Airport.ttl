@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/AirportShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/Airport> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/OrganizationShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/Organisation> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/airportShape> a sh:NodeShape ;
    sh:property [ sh:datatype <xsd:double> ;
            sh:path <http://dbpedia.org/ontology/runwayLength> ],
        [ sh:path <http://dbpedia.org/ontology/owner> ],
        [ sh:path <http://dbpedia.org/ontology/location> ],
        [ sh:datatype <xsd:string> ;
            sh:path <http://dbpedia.org/ontology/runwaySurface> ],
        [ sh:path <http://dbpedia.org/ontology/city> ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 2 ;
            sh:path <http://dbpedia.org/ontology/icaoLocationIdentifier> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/operator> ],
        [ sh:datatype <rdf:langString> ;
            sh:path foaf:name ],
        [ sh:class <http://dbpedia.org/ontology/Airport> ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:path <http://dbpedia.org/ontology/runwayDesignation> ],
        [ sh:datatype <xsd:double> ;
            sh:maxCount 1 ;
            sh:path dcat:resource_identifier ],
        [ sh:datatype <xsd:double> ;
            sh:path <http://dbpedia.org/ontology/elevation> ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 2 ;
            sh:path <http://dbpedia.org/ontology/faaLocationIdentifier> ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 2 ;
            sh:path <http://dbpedia.org/ontology/iataLocationIdentifier> ],
        [ sh:path foaf:homepage ] ;
    sh:targetClass <http://dbpedia.org/ontology/Airport> .

