@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/AirportShape> a sh:NodeShape ;
    rdfs:label "airport"@en ;
    sh:property [ sh:class wd:Q2221906 ;
            sh:maxCount 1 ;
            sh:name "located in/on physical feature"@en ;
            sh:path wdt:P706 ],
        [ sh:in ( wd:Q6452715 wd:Q1543615 ) ;
            sh:maxCount 1 ;
            sh:name "Wi-Fi access"@en ;
            sh:path wdt:P2848 ],
        [ sh:class wd:Q41176 ;
            sh:maxCount 1 ;
            sh:name "adjacent structure or building"@en ;
            sh:path wdt:P3032 ],
        [ sh:class wd:Q1433344 ;
            sh:name "has facility"@en ;
            sh:path wdt:P912 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "street address"@en ;
            sh:path wdt:P6375 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ],
        [ sh:maxCount 1 ;
            sh:name "location"@en ;
            sh:or ( [ sh:class wd:Q515 ] [ sh:class wd:Q3957 ] ) ;
            sh:path wdt:P276 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "official name"@en ;
            sh:path wdt:P1448 ],
        [ sh:maxCount 1 ;
            sh:name "state of use"@en ;
            sh:or ( [ sh:class wd:Q56557118 ] [ sh:class wd:Q11639308 ] ) ;
            sh:path wdt:P5817 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "date of official opening"@en ;
            sh:path wdt:P1619 ],
        [ sh:name "place served by transport hub"@en ;
            sh:or ( [ sh:class wd:Q515 ] [ sh:class wd:Q3957 ] [ sh:class wd:Q486972 ] ) ;
            sh:path wdt:P931 ],
        [ sh:class wd:Q30634609 ;
            sh:maxCount 1 ;
            sh:name "heritage designation"@en ;
            sh:path wdt:P1435 ],
        [ sh:hasValue wd:Q1571929 ;
            sh:maxCount 1 ;
            sh:name "has use"@en ;
            sh:path wdt:P366 ],
        [ sh:datatype xsd:string ;
            sh:name "runway"@en ;
            sh:path wdt:P529 ],
        [ sh:class wd:Q5107 ;
            sh:maxCount 1 ;
            sh:name "continent"@en ;
            sh:path wdt:P30 ],
        [ sh:maxCount 1 ;
            sh:name "official website"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P856 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:class wd:Q56061 ;
            sh:maxCount 1 ;
            sh:name "located in the administrative territorial entity"@en ;
            sh:path wdt:P131 ],
        [ sh:class wd:Q16695773 ;
            sh:maxCount 1 ;
            sh:name "on focus list of Wikimedia project"@en ;
            sh:path wdt:P5008 ],
        [ sh:class wd:Q12143 ;
            sh:maxCount 1 ;
            sh:name "located in time zone"@en ;
            sh:path wdt:P421 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "postal code"@en ;
            sh:path wdt:P281 ],
        [ sh:maxCount 1 ;
            sh:name "public transport stop"@en ;
            sh:or ( [ sh:class wd:Q548662 ] [ sh:class wd:Q55488 ] ) ;
            sh:path wdt:P8453 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "ICAO airport code"@en ;
            sh:path wdt:P239 ],
        [ sh:class wd:Q1248784 ;
            sh:name "scheduled service destination"@en ;
            sh:path wdt:P521 ],
        [ sh:class wd:Q62447 ;
            sh:maxCount 1 ;
            sh:name "replaces"@en ;
            sh:path wdt:P1365 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "directions"@en ;
            sh:path wdt:P2795 ],
        [ sh:maxCount 1 ;
            sh:name "owned by"@en ;
            sh:or ( [ sh:class wd:Q4830453 ] [ sh:class wd:Q515 ] [ sh:class wd:Q6256 ] ) ;
            sh:path wdt:P127 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:datatype xsd:decimal ;
            sh:name "patronage"@en ;
            sh:path wdt:P3872 ],
        [ sh:maxCount 1 ;
