            sh:path wdt:P361 ],
        [ sh:name "organizer"@en ;
            sh:or ( [ sh:class wd:Q43229 ] [ sh:class wd:Q4438121 ] ) ;
            sh:path wdt:P664 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:class wd:Q16510064 ;
            sh:maxCount 1 ;
            sh:name "followed by"@en ;
            sh:path wdt:P156 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "native label"@en ;
            sh:path wdt:P1705 ],
        [ sh:class wd:Q5 ;
            sh:name "referee"@en ;
            sh:path wdt:P1652 ],
        [ sh:maxCount 1 ;
            sh:name "sport"@en ;
            sh:or ( [ sh:class wd:Q31629 ] [ sh:class wd:Q349 ] ) ;
            sh:path wdt:P641 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "official name"@en ;
            sh:path wdt:P1448 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "number of matches played/races/starts"@en ;
            sh:path wdt:P1350 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "short name"@en ;
            sh:path wdt:P1813 ],
        [ sh:name "named after"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P138 ],
        [ sh:maxCount 1 ;
            sh:name "official website"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P856 ],
        [ sh:class wd:Q61685689 ;
            sh:maxCount 1 ;
            sh:name "tournament format"@en ;
            sh:path wdt:P8127 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "edition number"@en ;
            sh:path wdt:P393 ],
        [ sh:class wd:Q30227593 ;
            sh:maxCount 1 ;
            sh:name "time period"@en ;
            sh:path wdt:P2348 ],
        [ sh:maxCount 1 ;
            sh:name "sponsor"@en ;
