@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/DiseaseShape> a sh:NodeShape ;
    rdfs:label "disease"@en ;
    sh:property [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:maxCount 1 ;
            sh:name "external data available at URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1325 ],
        [ sh:class wd:Q7187 ;
            sh:maxCount 1 ;
            sh:name "genetic association"@en ;
            sh:path wdt:P2293 ],
        [ sh:maxCount 1 ;
            sh:name "studied by"@en ;
            sh:or ( [ sh:class wd:Q11862829 ] [ sh:class wd:Q1047113 ] ) ;
            sh:path wdt:P2579 ],
        [ sh:class wd:Q113145171 ;
            sh:name "drug or therapy used for treatment"@en ;
            sh:path wdt:P2176 ],
        [ sh:maxCount 1 ;
            sh:name "part of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P361 ],
        [ sh:name "health specialty"@en ;
            sh:or ( [ sh:class wd:Q930752 ] [ sh:class wd:Q44597158 ] ) ;
            sh:path wdt:P1995 ],
        [ sh:name "exact match"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P2888 ],
        [ sh:maxCount 1 ;
            sh:name "WordLift URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P6363 ],
        [ sh:class wd:Q12136 ;
            sh:name "has part(s)"@en ;
            sh:path wdt:P527 ],
        [ sh:class wd:Q12136 ;
            sh:maxCount 1 ;
            sh:name "opposite of"@en ;
            sh:path wdt:P461 ],
        [ sh:class wd:Q5 ;
            sh:name "discoverer or inventor"@en ;
            sh:path wdt:P61 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "time of discovery or invention"@en ;
            sh:path wdt:P575 ],
        [ sh:name "has effect"@en ;
            sh:or ( [ sh:class wd:Q112965645 ] [ sh:class wd:Q12136 ] ) ;
            sh:path wdt:P1542 ],
        [ sh:maxCount 1 ;
            sh:name "named after"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P138 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "NCI Thesaurus ID"@en ;
            sh:path wdt:P1748 ],
        [ sh:name "described at URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P973 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "prevalence"@en ;
            sh:path wdt:P1193 ],
        [ sh:maxCount 1 ;
            sh:name "anatomical location"@en ;
            sh:or ( [ sh:class wd:Q112826905 ] [ sh:class wd:Q103812529 ] ) ;
            sh:path wdt:P927 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "ICPC 2 ID"@en ;
            sh:path wdt:P667 ],
        [ sh:name "has cause"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P828 ],
        [ sh:name "medical examination"@en ;
            sh:or ( [ sh:class wd:Q177719 ] [ sh:class wd:Q2671652 ] ) ;
            sh:path wdt:P923 ],
        [ sh:class wd:Q16695773 ;
            sh:maxCount 1 ;
            sh:name "on focus list of Wikimedia project"@en ;
            sh:path wdt:P5008 ],
        [ sh:maxCount 1 ;
            sh:name "facet of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1269 ],
        [ sh:name "symptoms and signs"@en ;
            sh:or ( [ sh:class wd:Q112965645 ] [ sh:class wd:Q112826905 ] ) ;
            sh:path wdt:P780 ],
        [ sh:name "possible treatment"@en ;
            sh:or ( [ sh:class wdt:Q130705900 ] [ sh:class wd:Q179661 ] ) ;
            sh:path wdt:P924 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:maxCount 1 ;
            sh:name "said to be the same as"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P460 ],
        [ sh:class wd:Q103812529 ;
            sh:name "afflicts"@en ;
            sh:path wdt:P689 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "ICD-9-CM"@en ;
            sh:path wdt:P1692 ],
        [ sh:class wd:Q3331189 ;
            sh:name "described by source"@en ;
            sh:path wdt:P1343 ],
        [ sh:class wd:Q1662340 ;
            sh:name "disease transmission process"@en ;
            sh:path wdt:P1060 ],
        [ sh:name "risk factor"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P5642 ],
        [ sh:class wd:Q639907 ;
            sh:name "possible medical findings"@en ;
            sh:path wdt:P5131 ] ;
    sh:targetClass wd:Q12136 .

