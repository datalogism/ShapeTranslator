@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/ArtistShape> a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path <http://dbpedia.org/ontology/Person/height> ] ] [ sh:property [ sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path <http://dbpedia.org/ontology/height> ] ] ) ;
    sh:property [ sh:minCount 1 ;
            sh:or ( [ sh:class <http://dbpedia.org/ontology/PersonFunction> ] [ sh:class <http://dbpedia.org/ontology/Profession> ] ) ;
            sh:path <http://dbpedia.org/ontology/occupation> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/birthDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:sameAs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/deathDate> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/residence> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/Agent> ] [ sh:class <http://dbpedia.org/ontology/Work> ] ) ;
            sh:path <http://dbpedia.org/ontology/influencedBy> ],
        [ sh:class skos:Concept ;
            sh:path dcterms:subject ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/restingPlace> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:maxCount 2 ;
            sh:path <http://dbpedia.org/ontology/parent> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageID> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/birthPlace> ],
        [ sh:class <http://dbpedia.org/ontology/Image> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/thumbnail> ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/stateOfOrigin> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageLength> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:name ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/background> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/doctoralAdvisor> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/EducationalInstitution> ] [ sh:class <http://dbpedia.org/ontology/University> ] ) ;
            sh:path <http://dbpedia.org/ontology/almaMater> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/birthName> ],
        [ sh:class <http://dbpedia.org/ontology/Genre> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/genre> ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/nationality> ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path foaf:givenName ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:path <http://dbpedia.org/ontology/citizenship> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/institution> ],
        [ sh:class <http://dbpedia.org/ontology/Award> ;
            sh:path <http://dbpedia.org/ontology/award> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/Agent> ] [ sh:class <http://dbpedia.org/ontology/Work> ] ) ;
            sh:path <http://dbpedia.org/ontology/influenced> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/imdbId> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/movement> ],
        [ sh:class <http://dbpedia.org/ontology/MusicalArtist> ;
            sh:path <http://dbpedia.org/ontology/associatedMusicalArtist> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/pseudonym> ],
        [ sh:class <http://dbpedia.org/ontology/Instrument> ;
            sh:path <http://dbpedia.org/ontology/instrument> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/EducationalInstitution> ] [ sh:class <http://dbpedia.org/ontology/Organisation> ] [ sh:class <http://dbpedia.org/ontology/University> ] ) ;
            sh:path <http://dbpedia.org/ontology/training> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/relative> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:class <http://dbpedia.org/ontology/RecordLabel> ;
            sh:path <http://dbpedia.org/ontology/recordLabel> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageRevisionID> ],
        [ sh:nodeKind sh:Literal ;
            sh:path owl:sameAs ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/originalName> ],
        [ sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/birthYear> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageWikiLink> ;
            sh:pattern "^http://dbpedia.org/resource/" ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/activeYearsEndYear> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/activeYearsStartYear> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/child> ],
        [ sh:class <http://dbpedia.org/ontology/Image> ;
            sh:minCount 1 ;
            sh:path foaf:depiction ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/academicDiscipline> ],
        [ sh:class <http://dbpedia.org/ontology/Settlement> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/hometown> ],
        [ sh:class <http://dbpedia.org/ontology/Work> ;
            sh:path <http://dbpedia.org/ontology/notableWork> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/abstract> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/knownFor> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/spouse> ],
        [ sh:datatype xsd:string ;
            sh:path foaf:nick ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/field> ],
        [ sh:class <http://dbpedia.org/ontology/Band> ;
            sh:path <http://dbpedia.org/ontology/associatedBand> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/deathYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageExternalLink> ],
        [ sh:class <http://dbpedia.org/ontology/EducationalInstitution> ;
            sh:path <http://dbpedia.org/ontology/education> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/deathPlace> ],
        [ sh:class <http://dbpedia.org/ontology/Sound> ;
            sh:path <http://dbpedia.org/ontology/soundRecording> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/partner> ],
        [ sh:nodeKind sh:Literal ;
            sh:path foaf:isPrimaryTopicOf ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/alias> ],
        [ sh:nodeKind sh:Literal ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass <http://dbpedia.org/ontology/Artist> .

