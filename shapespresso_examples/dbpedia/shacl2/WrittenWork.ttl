@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://shaclshapes.org/written_workShape> a sh:NodeShape ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/literaryGenre> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:name ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/publisher> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/firstPublicationDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/type> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/lcc> ],
        [ sh:class <http://dbpedia.org/ontology/WrittenWork> ;
            sh:path <http://dbpedia.org/ontology/previousWork> ],
        [ sh:class <http://dbpedia.org/ontology/Magazine> ;
            sh:path <http://dbpedia.org/ontology/magazine> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/lastPublicationDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/numberOfVolumes> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/mediaType> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/numberOfPages> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/publicationDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/nonFictionSubject> ],
        [ sh:nodeKind sh:IRI ;
            sh:path dcat:resource_identifier ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/author> ],
        [ sh:class <http://dbpedia.org/ontology/WrittenWork> ;
            sh:path rdf:type ],
        [ sh:nodeKind sh:IRI ;
            sh:path dc:publisher ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/dcc> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/isbn> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/subsequentWork> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/language> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/oclc> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/genre> ] ;
    sh:targetClass <http://dbpedia.org/ontology/WrittenWork> .

