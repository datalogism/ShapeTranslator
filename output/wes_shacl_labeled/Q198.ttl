            sh:path wdt:P4220 ],
        [ sh:datatype xsd:decimal ;
            sh:name "number of deaths"@en ;
            sh:path wdt:P1120 ],
        [ sh:name "said to be the same as"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P460 ],
        [ sh:name "has part(s)"@en ;
