@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/MotorsportRacingTrackShape> a sh:NodeShape ;
    rdfs:label "motorsport racing track"@en ;
    sh:property [ sh:maxCount 1 ;
            sh:name "official website"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P856 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "short name"@en ;
            sh:path wdt:P1813 ],
        [ sh:class wd:Q67376938 ;
            sh:maxCount 1 ;
            sh:name "historic county"@en ;
            sh:path wdt:P7959 ],
        [ sh:class wd:Q43229 ;
            sh:name "owned by"@en ;
            sh:path wdt:P127 ],
        [ sh:name "heritage designation"@en ;
            sh:or ( [ sh:class wd:Q210272 ] [ sh:class wd:Q386426 ] ) ;
            sh:path wdt:P1435 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "postal code"@en ;
            sh:path wdt:P281 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:maxCount 1 ;
            sh:name "located in the administrative territorial entity"@en ;
            sh:or ( [ sh:class wd:Q7930989 ] [ sh:class wd:Q56061 ] [ sh:class wd:Q515 ] ) ;
            sh:path wdt:P131 ],
        [ sh:name "named after"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P138 ],
        [ sh:name "has part(s)"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P527 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "dissolved, abolished or demolished date"@en ;
            sh:path wdt:P576 ],
        [ sh:datatype xsd:decimal ;
            sh:name "social media followers"@en ;
            sh:path wdt:P8687 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "inception"@en ;
            sh:path wdt:P571 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons gallery"@en ;
            sh:path wdt:P935 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:maxCount 1 ;
            sh:name "operator"@en ;
            sh:or ( [ sh:class wd:Q6881511 ] [ sh:class wd:Q4830453 ] [ sh:class wd:Q15911314 ] [ sh:class wd:Q43229 ] ) ;
            sh:path wdt:P137 ],
        [ sh:maxCount 1 ;
            sh:name "location"@en ;
            sh:or ( [ sh:class wd:Q17334923 ] [ sh:class wd:Q2221906 ] ) ;
            sh:path wdt:P276 ],
        [ sh:datatype xsd:decimal ;
            sh:name "slope"@en ;
            sh:path wdt:P4184 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "native label"@en ;
            sh:path wdt:P1705 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "street address"@en ;
            sh:path wdt:P6375 ],
        [ sh:datatype xsd:decimal ;
            sh:name "length"@en ;
            sh:path wdt:P2043 ],
        [ sh:maxCount 1 ;
            sh:name "located in/on physical feature"@en ;
            sh:or ( [ sh:class wd:Q618123 ] [ sh:class wd:Q2221906 ] [ sh:class wd:Q82794 ] ) ;
            sh:path wdt:P706 ],
        [ sh:maxCount 1 ;
            sh:name "used by"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1535 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "elevation above sea level"@en ;
            sh:path wdt:P2044 ],
        [ sh:maxCount 1 ;
            sh:name "part of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P361 ],
        [ sh:in ( wd:Q5367 wd:Q5386 ) ;
            sh:maxCount 1 ;
            sh:name "sport"@en ;
            sh:path wdt:P641 ],
        [ sh:class wd:Q12143 ;
            sh:maxCount 1 ;
            sh:name "located in time zone"@en ;
            sh:path wdt:P421 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "number of matches played/races/starts"@en ;
            sh:path wdt:P1350 ],
        [ sh:name "significant event"@en ;
            sh:or ( [ sh:class wd:Q1656682 ] [ sh:class wd:Q1914636 ] ) ;
            sh:path wdt:P793 ],
        [ sh:datatype rdf:langString ;
            sh:name "official name"@en ;
            sh:path wdt:P1448 ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:name "nickname"@en ;
            sh:path wdt:P1449 ] ;
    sh:targetClass wd:Q2338524 .

