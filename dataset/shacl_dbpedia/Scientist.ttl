@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:ScientistShape a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:class dbo:Country ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path dbo:nationality ] ] [ sh:property [ sh:class dbo:Country ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path dbo:citizenship ] ] ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:deathYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsStartYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsEndYear ],
        [ sh:or ( [ sh:class dbo:Tenure ] [ sh:class dbo:TimePeriod ] ) ;
            sh:path dbo:termPeriod ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:birthPlace ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path foaf:name ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:deathPlace ],
        [ sh:class dbo:Place ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:residence ],
        [ sh:class dbo:Country ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:country ],
        [ sh:class dbo:Country ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:stateOfOrigin ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthName ],
        [ sh:class dbo:Profession ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:occupation ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:knownFor ],
        [ sh:minCount 1 ;
            sh:or ( [ sh:class dbo:AcademicSubject ] [ sh:class dbo:MedicalSpecialty ] ) ;
            sh:path dbo:academicDiscipline ],
        [ sh:class dbo:EducationalInstitution ;
            sh:minCount 1 ;
            sh:path dbo:education ],
        [ sh:class dbo:EducationalInstitution ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:almaMater ],
        [ sh:class dbo:Organisation ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:institution ],
        [ sh:datatype xsd:string ;
            sh:path dbo:alternativeName ],
        [ sh:class dbo:Organisation ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:employer ],
        [ sh:class dbo:Award ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:award ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:doctoralAdvisor ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:academicAdvisor ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:doctoralStudent ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:notableStudent ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:spouse ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:child ],
        [ sh:class dbo:Sound ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:soundRecording ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:title ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:imdbId ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:deathDate ] ;
    sh:targetClass dbo:Scientist .

