@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/BuilderShape> a sh:NodeShape ;
    sh:property [ sh:in ( <http://dbpedia.org/ontology/Agent> <http://dbpedia.org/ontology/Company> ) ;
            sh:path rdf:type ] .

<http://shaclshapes.org/MeanOfTransportationShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/MeanOfTransportation> ;
            sh:path rdf:type ],
        [ sh:hasValue <http://dbpedia.org/ontology/MeanOfTransportation> ;
            sh:path rdf:type ],
        [ sh:hasValue <http://dbpedia.org/ontology/MeanOfTransportation> ;
            sh:path rdf:type ],
        [ sh:hasValue <http://dbpedia.org/ontology/MeanOfTransportation> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/OrganisationShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/Organisation> ;
            sh:path rdf:type ],
        [ sh:hasValue <http://dbpedia.org/ontology/Organisation> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/mean_of_transportationShape> a sh:NodeShape ;
    sh:property [ sh:class <http://dbpedia.org/ontology/MeanOfTransportation> ;
            sh:path <http://dbpedia.org/ontology/predecessor> ],
        [ sh:datatype <xsd:gYear> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/activeYearsStartYear> ],
        [ sh:path <http://dbpedia.org/ontology/assembly> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/manufacturer> ],
        [ sh:datatype <xsd:double> ;
            sh:path <http://dbpedia.org/ontology/width> ],
        [ sh:datatype <rdf:langString> ;
            sh:path <http://dbpedia.org/ontology/alternativeName> ],
        [ sh:datatype <xsd:integer> ;
            sh:path <http://dbpedia.org/ontology/capacity> ],
        [ sh:datatype <xsd:gYear> ;
            sh:path <http://dbpedia.org/ontology/modelEndYear> ],
        [ sh:datatype <xsd:gYear> ;
            sh:path <http://dbpedia.org/ontology/productionEndYear> ],
        [ sh:datatype <xsd:double> ;
            sh:path <http://dbpedia.org/ontology/shipBeam> ],
        [ sh:datatype <xsd:string> ;
            sh:path <http://dbpedia.org/ontology/transmission> ],
        [ sh:datatype <xsd:gYear> ;
            sh:path <http://dbpedia.org/ontology/modelStartYear> ],
        [ sh:path <http://dbpedia.org/ontology/type> ],
        [ sh:datatype <xsd:string> ;
            sh:path <http://dbpedia.org/ontology/status> ],
        [ sh:class <http://dbpedia.org/ontology/MeanOfTransportation> ;
            sh:path <http://dbpedia.org/ontology/successor> ],
        [ sh:datatype <xsd:gYear> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/activeYearsEndYear> ],
        [ sh:datatype <xsd:double> ;
            sh:path <http://dbpedia.org/ontology/length> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/operator> ],
        [ sh:datatype <xsd:gYear> ;
            sh:path <http://dbpedia.org/ontology/productionStartYear> ],
        [ sh:class <http://dbpedia.org/ontology/MeanOfTransportation> ;
            sh:path <http://dbpedia.org/ontology/relatedMeanOfTransportation> ],
        [ sh:path <http://dbpedia.org/ontology/layout> ],
        [ sh:path <http://dbpedia.org/ontology/engine> ],
        [ sh:datatype <xsd:gYear> ;
            sh:path <http://dbpedia.org/ontology/yearOfConstruction> ],
        [ sh:datatype <xsd:double> ;
            sh:maxCount 1 ;
            sh:path dcat:resource_identifier ],
        [ sh:datatype <rdf:langString> ;
            sh:path foaf:name ],
        [ sh:datatype <xsd:double> ;
            sh:maxCount 2 ;
            sh:path <http://dbpedia.org/ontology/height> ],
        [ sh:datatype <xsd:integer> ;
            sh:path <http://dbpedia.org/ontology/numberBuilt> ],
        [ sh:class <http://dbpedia.org/ontology/MeanOfTransportation> ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:double> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/weight> ],
        [ sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:datatype <xsd:double> ;
            sh:path <http://dbpedia.org/ontology/wheelbase> ],
        [ sh:path <http://dbpedia.org/ontology/bodyStyle> ],
        [ sh:path <http://dbpedia.org/ontology/class> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/Agent> ] [ sh:class <http://dbpedia.org/ontology/Company> ] ) ;
            sh:path <http://dbpedia.org/ontology/builder> ],
        [ sh:path <http://dbpedia.org/ontology/owner> ],
        [ sh:datatype <xsd:date> ;
            sh:path <http://dbpedia.org/ontology/shipLaunch> ] ;
    sh:targetClass <http://dbpedia.org/ontology/MeanOfTransportation> .

