@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/SkiResortShape> a sh:NodeShape ;
    rdfs:label "ski resort"@en ;
    sh:property [ sh:maxCount 1 ;
            sh:name "location"@en ;
            sh:or ( [ sh:class wd:Q515 ] [ sh:class wd:Q3957 ] [ sh:class wd:Q532 ] ) ;
            sh:path wdt:P276 ],
        [ sh:maxCount 1 ;
            sh:name "operator"@en ;
            sh:or ( [ sh:class wd:Q4830453 ] [ sh:class wd:Q6881511 ] ) ;
            sh:path wdt:P137 ],
