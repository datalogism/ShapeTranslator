@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:CelestialBodyShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:apoapsis ],
        [ sh:datatype xsd:double ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:temperature ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:mass ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:density ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:averageSpeed ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:orbitalPeriod ];
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:detectionMethod ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:neighbourConstellations ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:periapsis ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:rotationPeriod ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:escapeVelocity ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:averageSpeed ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:name ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:formerName ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:volume ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:meanRadius ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:abbreviation ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:surfaceArea ],
        [ sh:datatype xsd:double ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:absoluteMagnitude ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:apparentMagnitude ],
        [ sh:datatype xsd:double ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:albedo ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:date ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:discovered ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:class dbo:Person ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:discoverer ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:epoch ] ;
    sh:targetClass dbo:CelestialBody .

