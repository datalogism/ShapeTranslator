            sh:nodeKind sh:IRI ;
            sh:path wdt:P1542 ],
        [ sh:name "has immediate cause"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1478 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:class wd:Q82794 ;
            sh:name "location"@en ;
            sh:path wdt:P276 ],
        [ sh:name "named after"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P138 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "point in time"@en ;
            sh:path wdt:P585 ],
        [ sh:class wd:Q5 ;
            sh:name "significant person"@en ;
            sh:path wdt:P3342 ],
        [ sh:name "followed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P156 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "start time"@en ;
            sh:path wdt:P580 ],
        [ sh:name "facet of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1269 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "end time"@en ;
            sh:path wdt:P582 ],
        [ sh:class wd:Q386724 ;
            sh:maxCount 1 ;
            sh:name "present in work"@en ;
            sh:path wdt:P1441 ],
        [ sh:name "described by source"@en ;
            sh:or ( [ sh:class wd:Q3331189 ] [ sh:class wd:Q47461344 ] ) ;
            sh:path wdt:P1343 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:maxCount 1 ;
            sh:name "follows"@en ;
