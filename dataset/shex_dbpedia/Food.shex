PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX yago: <http://yago-knowledge.org/resource/>

start = @<Food>

<Food> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Food> ] ;
  rdfs:label rdf:langString + ;
  <http://dbpedia.org/ontology/region> @<Place> * ;
  <http://dbpedia.org/ontology/cuisine> xsd:string * ;
  <http://dbpedia.org/ontology/creatorOfDish> @<AgentOrEthnicGroupOrThing> * ;
  <http://dbpedia.org/ontology/ingredient> @<FoodOrTaxonOrBiologicalLivingObject> + ;
  <http://xmlns.com/foaf/0.1/name> xsd:string + ;
  <http://dbpedia.org/ontology/ingredientName> xsd:string + ;
  <http://dbpedia.org/ontology/related> @<Food_class> * ;
  <http://dbpedia.org/ontology/hasVariant> @<Food_class> * ;
  <http://dbpedia.org/ontology/alias> rdf:langString * ;
  <http://dbpedia.org/ontology/protein> xsd:double ? ;
  <http://dbpedia.org/ontology/approximateCalories> xsd:double ? ;
  <http://dbpedia.org/ontology/servingSize> xsd:double ? ;
  <http://dbpedia.org/ontology/servingTemperature> xsd:string ? ;
  <http://dbpedia.org/ontology/manufacturer> @<Agent> * ;
  <http://dbpedia.org/ontology/distributor> @<Organisation> * ;
  <http://dbpedia.org/ontology/picture> @<Image> * ;
  <http://dbpedia.org/ontology/wikiPageRevisionID> xsd:integer + ;
  rdfs:comment rdf:langString + ;
  <http://dbpedia.org/ontology/notes> xsd:string * ;
  <http://dbpedia.org/ontology/year> xsd:gYear ? ;
  <http://dbpedia.org/ontology/origin> @<Place> * ;
  <http://dbpedia.org/ontology/country> @<Country> *
}

<Agent> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Agent> ]
}

<AgentOrEthnicGroupOrThing> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Agent> <http://dbpedia.org/ontology/EthnicGroup> owl:Thing ]
}

<Country> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Country> ]
}

<FoodOrTaxonOrBiologicalLivingObject> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Food> <http://dbpedia.org/ontology/Taxon> <http://umbel.org/umbel/rc/BiologicalLivingObject> ]
}

<Food_class> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Food> ]
}

<Image> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Image> ]
}

<Organisation> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Organisation> ]
}

<Place> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Place> ]
}
