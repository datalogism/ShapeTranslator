@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix dbt: <http://dbpedia.org/datatype/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:CityShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:areaTotal ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:populationUrbanDensity ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:populationMetroDensity ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:area ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:areaMetro ],
        [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:areaUrban ],
        [ sh:datatype xsd:double ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:populationDensity ];
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:foundingDate ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:founder ],
        [ sh:class dbo:Country ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:country ],
        [ sh:class dbo:PopulatedPlace ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:district ],
        [ sh:class dbo:PopulatedPlace ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:federalState ],
        [ sh:class dbo:AdministrativeRegion ;
            sh:minCount 1 ;
            sh:path dbo:subdivision ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:isoCodeRegion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:postalCode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:areaCode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:licenceNumber ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:name ],
        [ sh:minCount 1 ;
            sh:node shapes:TimeZoneShape ;
            sh:path dbo:timeZone ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:utcOffset ],
        [ sh:datatype xsd:double ;
            sh:minCount 1 ;
            sh:path dbo:elevation ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:minimumElevation ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:maximumElevation ],
        [ sh:minCount 1 ;
            sh:or ( [ sh:datatype xsd:double ] [ sh:datatype dbt:squareKilometre ] ) ;
            sh:path dbo:areaTotal ],
        [ sh:datatype xsd:string ;
            sh:path foaf:nick ],
        [ sh:datatype xsd:double ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:areaLand ],
        [ sh:datatype xsd:double ;
            sh:path dbo:areaWater ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:percentageOfAreaWater ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:areaMetro ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:originalName ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:demonym ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:motto ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:populationTotal ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:populationUrban ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:populationMetro ],
        [ sh:datatype xsd:date ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:populationAsOf ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:synonym ],
        [ sh:class dbo:GovernmentType ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:governmentType ],
        [ sh:class dbo:Legislature ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:governingBody ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dbo:leaderName ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:leaderTitle ],
        [ sh:class dbo:PoliticalParty ;
            sh:path dbo:leaderParty ],
        [ sh:class dbo:PoliticalFunction ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:politicalLeader ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:namedAfter ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ] ;
    sh:targetClass dbo:City .

