@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:MonumentShape a sh:NodeShape ;
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:location ],
        [ sh:class dbo:Agent ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:designer ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ] ;
    sh:targetClass dbo:Monument .

