@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/SearchEngineShape> a sh:NodeShape ;
    rdfs:label "search engine"@en ;
    sh:property [ sh:class wd:Q4830453 ;
            sh:name "owned by"@en ;
            sh:path wdt:P127 ],
        [ sh:name "distributed by"@en ;
            sh:or ( [ sh:class wd:Q3814081 ] [ sh:class wd:Q35127 ] ) ;
            sh:path wdt:P750 ],
        [ sh:class wd:Q4830453 ;
            sh:name "operator"@en ;
            sh:path wdt:P137 ],
        [ sh:maxCount 1 ;
            sh:name "has use"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P366 ],
        [ sh:class wd:Q7406919 ;
            sh:name "product or material produced"@en ;
            sh:path wdt:P1056 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ],
        [ sh:maxCount 1 ;
            sh:name "source code repository URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1324 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "Alexa rank"@en ;
            sh:path wdt:P1661 ],
        [ sh:maxCount 1 ;
            sh:name "privacy policy URL"@en ;
