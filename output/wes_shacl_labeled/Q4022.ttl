@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/RiverShape> a sh:NodeShape ;
    rdfs:label "river"@en ;
    sh:property [ sh:class wd:Q15324 ;
            sh:maxCount 1 ;
            sh:name "mouth of the watercourse"@en ;
            sh:path wdt:P403 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "elevation above sea level"@en ;
            sh:path wdt:P2044 ],
        [ sh:maxCount 1 ;
            sh:name "mountain range"@en ;
            sh:or ( [ sh:class wd:Q1061151 ] [ sh:class wd:Q8502 ] [ sh:class wd:Q46831 ] ) ;
            sh:path wdt:P4552 ],
        [ sh:class wd:Q23397 ;
            sh:name "lake on watercourse"@en ;
            sh:path wdt:P469 ],
        [ sh:class wd:Q43229 ;
            sh:name "maintained by"@en ;
            sh:path wdt:P126 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "maximum Strahler number"@en ;
            sh:path wdt:P1548 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ],
        [ sh:class wd:Q5107 ;
            sh:maxCount 1 ;
            sh:name "continent"@en ;
            sh:path wdt:P30 ],
        [ sh:datatype xsd:decimal ;
            sh:name "area"@en ;
            sh:path wdt:P2046 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:class wd:Q89210005 ;
            sh:maxCount 1 ;
            sh:name "tributary orientation"@en ;
            sh:path wdt:P3871 ],
        [ sh:class wd:Q16695773 ;
            sh:maxCount 1 ;
            sh:name "on focus list of Wikimedia project"@en ;
            sh:path wdt:P5008 ],
        [ sh:maxCount 1 ;
            sh:name "origin of the watercourse"@en ;
            sh:or ( [ sh:class wd:Q271669 ] [ sh:class wd:Q15324 ] ) ;
            sh:path wdt:P885 ],
        [ sh:class wd:Q166620 ;
            sh:maxCount 1 ;
            sh:name "drainage basin"@en ;
            sh:path wdt:P4614 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "length"@en ;
            sh:path wdt:P2043 ],
        [ sh:maxCount 1 ;
            sh:name "named after"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P138 ],
        [ sh:name "has use"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P366 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "watershed area"@en ;
            sh:path wdt:P2053 ],
        [ sh:name "connects with"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P2789 ],
        [ sh:name "impounded by"@en ;
            sh:or ( [ sh:class wd:Q12323 ] [ sh:class wd:Q105190 ] ) ;
            sh:path wdt:P4792 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "discharge"@en ;
            sh:path wdt:P2225 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "slope"@en ;
            sh:path wdt:P4184 ],
        [ sh:name "has part(s)"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P527 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:name "described by source"@en ;
            sh:or ( [ sh:class wd:Q3331189 ] [ sh:class wd:Q47461344 ] ) ;
            sh:path wdt:P1343 ],
        [ sh:name "part of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P361 ],
        [ sh:maxCount 1 ;
            sh:name "location"@en ;
            sh:or ( [ sh:class wd:Q82794 ] [ sh:class wd:Q618123 ] [ sh:class wd:Q2221906 ] [ sh:class wd:Q17334923 ] ) ;
            sh:path wdt:P276 ],
        [ sh:name "tributary"@en ;
            sh:or ( [ sh:class wd:Q4022 ] [ sh:class wd:Q355304 ] ) ;
            sh:path wdt:P974 ],
        [ sh:class wd:Q67376938 ;
            sh:maxCount 1 ;
            sh:name "historic county"@en ;
            sh:path wdt:P7959 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "category for the water basin"@en ;
            sh:path wdt:P1200 ],
        [ sh:maxCount 1 ;
            sh:name "said to be the same as"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P460 ],
        [ sh:class wd:Q473972 ;
            sh:name "located in protected area"@en ;
            sh:path wdt:P3018 ],
        [ sh:datatype rdf:langString ;
            sh:name "native label"@en ;
            sh:path wdt:P1705 ],
        [ sh:datatype rdf:langString ;
            sh:name "official name"@en ;
            sh:path wdt:P1448 ],
        [ sh:class wd:Q12143 ;
            sh:name "located in time zone"@en ;
            sh:path wdt:P421 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "waterbody number"@en ;
            sh:path wdt:P1183 ],
        [ sh:class wd:Q6256 ;
            sh:name "basin country"@en ;
            sh:path wdt:P205 ],
        [ sh:maxCount 1 ;
            sh:name "heritage designation"@en ;
            sh:or ( [ sh:class wd:Q210272 ] [ sh:class wd:Q386426 ] ) ;
            sh:path wdt:P1435 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons gallery"@en ;
            sh:path wdt:P935 ],
        [ sh:maxCount 1 ;
            sh:name "located in the administrative territorial entity"@en ;
            sh:or ( [ sh:class wd:Q56061 ] [ sh:class wd:Q7930989 ] ) ;
            sh:path wdt:P131 ],
        [ sh:maxCount 1 ;
            sh:name "located in/on physical feature"@en ;
            sh:or ( [ sh:class wd:Q82794 ] [ sh:class wd:Q618123 ] [ sh:class wd:Q2221906 ] ) ;
            sh:path wdt:P706 ] ;
    sh:targetClass wd:Q4022 .

