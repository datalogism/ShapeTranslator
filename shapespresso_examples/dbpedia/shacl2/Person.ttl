@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://shaclshapes.org/personShape> a sh:NodeShape ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/deathDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:givenName ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/termPeriod> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/squadNumber> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/birthName> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/deathPlace> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/associatedBand> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/recordLabel> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/birthDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/background> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/activeYearsEndYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/deathYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/activeYearsStartYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/genre> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/associatedMusicalArtist> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/parent> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/occupation> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:name ],
        [ sh:nodeKind sh:IRI ;
            sh:path dcat:resource_identifier ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/spouse> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/birthPlace> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/birthYear> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/predecessor> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/currentMember> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/alias> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/team> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/successor> ] ;
    sh:targetClass <http://dbpedia.org/ontology/Person> .

