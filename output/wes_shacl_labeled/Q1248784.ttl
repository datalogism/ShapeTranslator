            sh:path wdt:P576 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "phone number"@en ;
            sh:path wdt:P1329 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "elevation above sea level"@en ;
            sh:path wdt:P2044 ],
        [ sh:class wd:Q43229 ;
            sh:maxCount 1 ;
            sh:name "operator"@en ;
            sh:path wdt:P137 ],
        [ sh:class wd:Q12819564 ;
            sh:name "interchange station"@en ;
            sh:path wdt:P833 ],
        [ sh:class wd:Q67770276 ;
            sh:maxCount 1 ;
            sh:name "historic county"@en ;
            sh:path wdt:P7959 ],
        [ sh:class wd:Q10541491 ;
            sh:maxCount 1 ;
            sh:name "legal form"@en ;
            sh:path wdt:P1454 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "social media followers"@en ;
            sh:path wdt:P8687 ],
        [ sh:name "named after"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P138 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "area"@en ;
            sh:path wdt:P2046 ],
        [ sh:class wd:Q62447 ;
            sh:maxCount 1 ;
            sh:name "replaced by"@en ;
            sh:path wdt:P1366 ],
        [ sh:class wd:Q108284447 ;
            sh:name "significant event"@en ;
            sh:path wdt:P793 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "IATA airport code"@en ;
            sh:path wdt:P238 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:maxCount 1 ;
            sh:name "architect"@en ;
            sh:or ( [ sh:class wd:Q5 ] [ sh:class wd:Q783794 ] ) ;
            sh:path wdt:P84 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "FAA airport code"@en ;
            sh:path wdt:P240 ] ;
    sh:targetClass wd:Q1248784 .

