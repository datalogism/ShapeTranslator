@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo1: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:SportsTeamShape a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:datatype xsd:gYear ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:startYear ] ] [ sh:property [ sh:datatype xsd:gYear ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:foundingYear ] ] ),
        ( [ sh:property [ sh:class dbo:City ;
                        sh:nodeKind sh:IRI ;
                        sh:path dbo:locationCity ] ] [ sh:property [ sh:class dbo:Place ;
                        sh:nodeKind sh:IRI ;
                        sh:path dbo:location ] ] ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:formationDate ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:foundingYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:dissolutionYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:foundingYear ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:title ],
        [ sh:class dbo:City ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:city ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:location ],
        [ sh:class dbo:Sport ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:sport ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:nick ],
        [ sh:class dbo:SportsLeague ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:league ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:status ],
        [ sh:class dbo:Stadium ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path [ sh:alternativePath ( dbo:stadium dbo:homeStadium ) ] ],
        [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class geo1:SpatialThing ] [ sh:class dbo:Place ] ) ;
            sh:path dbo:ground ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:mascot ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:capacity ],
        [ sh:class dbo:Person ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:coach ],
        [ sh:class dbo:Person ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:manager ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:generalManager ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:director ],
        [ sh:class dbo:Agent ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:owner ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:chairman ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:president ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:uciCode ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:name ],
        [ sh:class dbo:Colour ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:colour ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:logo ] ;
    sh:targetClass dbo:SportsTeam .

