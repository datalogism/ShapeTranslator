@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/ComicsCharacterShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/ComicsCharacter> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/comics_characterShape> a sh:NodeShape ;
    sh:property [ sh:class <http://dbpedia.org/ontology/ComicsCharacter> ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ sh:path <http://dbpedia.org/ontology/creator> ],
        [ sh:datatype <rdf:langString> ;
            sh:path foaf:givenName ],
        [ sh:datatype <rdf:langString> ;
            sh:path foaf:name ],
        [ sh:datatype <xsd:double> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dcat:resource_identifier ] ;
    sh:targetClass <http://dbpedia.org/ontology/ComicsCharacter> .

