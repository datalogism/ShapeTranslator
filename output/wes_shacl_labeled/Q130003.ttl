            sh:name "webcam page URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P4238 ],
        [ sh:class wd:Q5107 ;
            sh:maxCount 1 ;
            sh:name "continent"@en ;
            sh:path wdt:P30 ],
        [ sh:class wd:Q67376938 ;
            sh:maxCount 1 ;
