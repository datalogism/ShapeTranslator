@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://shaclshapes.org/CityShape> a sh:NodeShape ;
    sh:property [ sh:in ( <http://dbpedia.org/ontology/Location> <http://dbpedia.org/ontology/Place> ) ;
            sh:path rdf:type ] .

<http://shaclshapes.org/CompanyShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/Company> ;
            sh:path rdf:type ],
        [ sh:hasValue <http://dbpedia.org/ontology/Company> ;
            sh:path rdf:type ],
        [ sh:hasValue <http://dbpedia.org/ontology/Company> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/GenreShape> a sh:NodeShape ;
    sh:property [ sh:in ( <http://dbpedia.org/ontology/Genre> <http://dbpedia.org/ontology/MusicGenre> ) ;
            sh:path rdf:type ] .

<http://shaclshapes.org/companyShape> a sh:NodeShape ;
    sh:property [ sh:path <http://dbpedia.org/ontology/assets> ],
        [ sh:path <http://dbpedia.org/ontology/netIncome> ],
        [ sh:path <http://dbpedia.org/ontology/location> ],
        [ sh:path <http://dbpedia.org/ontology/formerName> ],
        [ sh:path <http://dbpedia.org/ontology/fate> ],
        [ sh:path <http://dbpedia.org/ontology/type> ],
        [ sh:path <http://dbpedia.org/ontology/locationCountry> ],
        [ sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:class <http://dbpedia.org/ontology/Company> ;
            sh:path <http://dbpedia.org/ontology/parentCompany> ],
        [ sh:path <http://dbpedia.org/ontology/numberOfEmployees> ],
        [ sh:path <http://dbpedia.org/ontology/equity> ],
        [ sh:path <http://dbpedia.org/ontology/regionServed> ],
        [ sh:path <http://dbpedia.org/ontology/foundedBy> ],
        [ sh:path dcat:resource_identifier ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/Genre> ] [ sh:class <http://dbpedia.org/ontology/MusicGenre> ] ) ;
            sh:path <http://dbpedia.org/ontology/genre> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/Location> ] [ sh:class <http://dbpedia.org/ontology/Place> ] ) ;
            sh:path <http://dbpedia.org/ontology/locationCity> ],
        [ sh:path <http://dbpedia.org/ontology/numberOfLocations> ],
        [ sh:path <http://dbpedia.org/ontology/industry> ],
        [ sh:path <http://dbpedia.org/ontology/revenue> ],
        [ sh:path <http://dbpedia.org/ontology/foundingYear> ],
        [ sh:path foaf:name ],
        [ sh:path <http://dbpedia.org/ontology/foundingDate> ],
        [ sh:class <http://dbpedia.org/ontology/Company> ;
            sh:path <http://dbpedia.org/ontology/distributingCompany> ],
        [ sh:path <http://dbpedia.org/ontology/headquarter> ],
        [ sh:path <http://dbpedia.org/ontology/keyPerson> ],
        [ sh:class <http://dbpedia.org/ontology/Company> ;
            sh:path <http://dbpedia.org/ontology/distributingLabel> ],
        [ sh:path <http://dbpedia.org/ontology/service> ],
        [ sh:path foaf:homepage ],
        [ sh:path <http://dbpedia.org/ontology/product> ] ;
    sh:targetClass <http://dbpedia.org/ontology/Company> .

