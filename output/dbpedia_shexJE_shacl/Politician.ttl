        [ sh:path <http://dbpedia.org/ontology/award> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/father> ],
        [ sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:class <http://dbpedia.org/ontology/EducationalInstitution> ;
            sh:path <http://dbpedia.org/ontology/almaMater> ],
        [ sh:class <http://dbpedia.org/ontology/Royalty> ;
            sh:path <http://dbpedia.org/ontology/monarch> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/deathPlace> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/Person/height> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/birthYear> ],
        [ sh:class <http://dbpedia.org/ontology/Politician> ;
            sh:path <http://dbpedia.org/ontology/vicePresident> ],
        [ sh:nodeKind sh:Literal ;
