@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/WarShape> a sh:NodeShape ;
    rdfs:label "war"@en ;
    sh:property [ sh:class wd:Q11514315 ;
            sh:maxCount 1 ;
            sh:name "time period"@en ;
            sh:path wdt:P2348 ],
        [ sh:class wd:Q16334295 ;
            sh:name "participant"@en ;
            sh:path wdt:P710 ],
        [ sh:class wd:Q56061 ;
            sh:name "located in the administrative territorial entity"@en ;
            sh:path wdt:P131 ],
        [ sh:class wd:Q6256 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ],
        [ sh:datatype rdf:langString ;
            sh:name "native label"@en ;
            sh:path wdt:P1705 ],
        [ sh:name "part of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P361 ],
        [ sh:name "has cause"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P828 ],
        [ sh:datatype xsd:decimal ;
