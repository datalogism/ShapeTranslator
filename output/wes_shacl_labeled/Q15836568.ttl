@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/ComputerNetworkProtocolShape> a sh:NodeShape ;
    rdfs:label "computer network protocol"@en ;
