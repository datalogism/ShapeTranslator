@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/CardGameShape> a sh:NodeShape ;
    rdfs:label "card game"@en ;
    sh:name "card game"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:name "author name string"@en ;
            sh:path wdt:P2093 ],
        [ sh:class wd:Q16695773 ;
            sh:maxCount 1 ;
