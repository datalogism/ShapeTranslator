@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:ArtistShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:height ];
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:background ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:deathDate ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:deathYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsStartYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsEndYear ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:birthPlace ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:deathPlace ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:restingPlace ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:name ],
        [ sh:class dbo:Settlement ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:hometown ],
        [ sh:class dbo:Country ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:stateOfOrigin ],
        [ sh:class dbo:Country ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:nationality ],
        [ sh:class dbo:Country ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:citizenship ],
        [ sh:minCount 1 ;
            sh:or ( [ sh:class dbo:PersonFunction ] [ sh:class dbo:Profession ] ) ;
            sh:path dbo:occupation ],
        [ sh:class dbo:Genre ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:genre ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path foaf:givenName ],
        [ sh:class dbo:Instrument ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:instrument ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:field ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:movement ],
        [ sh:class dbo:EducationalInstitution ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:education ],
        [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class dbo:EducationalInstitution ] [ sh:class dbo:University ] ) ;
            sh:path dbo:almaMater ],
        [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class dbo:EducationalInstitution ] [ sh:class dbo:Organisation ] [ sh:class dbo:University ] ) ;
            sh:path dbo:training ],
        [ sh:datatype xsd:string ;
            sh:path foaf:nick ],
        [ sh:class dbo:Work ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:notableWork ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:knownFor ],
        [ sh:class dbo:Award ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:award ],
        [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class dbo:Agent ] [ sh:class dbo:Work ] ) ;
            sh:path dbo:influencedBy ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthName ],
        [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class dbo:Agent ] [ sh:class dbo:Work ] ) ;
            sh:path dbo:influenced ],
        [ sh:class dbo:MusicalArtist ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:associatedMusicalArtist ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:alias ],
        [ sh:class dbo:Band ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:associatedBand ],
        [ sh:class dbo:RecordLabel ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:recordLabel ],
        [ sh:class dbo:Person ;
            sh:maxCount 2 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:parent ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:child ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:spouse ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:partner ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:relative ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:pseudonym ],
        [ sh:class dbo:Sound ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:soundRecording ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:imdbId ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ] ;
    sh:targetClass dbo:Artist .

