@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/CityShape> a sh:NodeShape ;
    sh:property [ sh:in ( <http://dbpedia.org/ontology/Location> <http://dbpedia.org/ontology/Place> ) ;
            sh:path rdf:type ] .

<http://shaclshapes.org/UniversityShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/University> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/universityShape> a sh:NodeShape ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:path <http://dbpedia.org/ontology/motto> ],
        [ sh:datatype <xsd:integer> ;
            sh:path <http://dbpedia.org/ontology/facultySize> ],
        [ sh:datatype <rdf:langString> ;
            sh:path foaf:name ],
        [ sh:path foaf:homepage ],
        [ sh:path <http://dbpedia.org/ontology/president> ],
        [ sh:path <http://dbpedia.org/ontology/affiliation> ],
        [ sh:datatype <rdf:langString> ;
            sh:path <http://dbpedia.org/ontology/formerName> ],
        [ sh:path <http://dbpedia.org/ontology/campus> ],
        [ sh:path <http://dbpedia.org/ontology/dean> ],
        [ sh:path <http://dbpedia.org/ontology/rector> ],
        [ sh:datatype <xsd:date> ;
            sh:path <http://dbpedia.org/ontology/foundingDate> ],
        [ sh:datatype <xsd:integer> ;
            sh:path <http://dbpedia.org/ontology/numberOfPostgraduateStudents> ],
        [ sh:path <http://dbpedia.org/ontology/state> ],
        [ sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:path <http://dbpedia.org/ontology/chancellor> ],
        [ sh:class <http://dbpedia.org/ontology/University> ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:integer> ;
            sh:path <http://dbpedia.org/ontology/numberOfUndergraduateStudents> ],
        [ sh:path <http://dbpedia.org/ontology/type> ],
        [ sh:datatype <xsd:double> ;
            sh:maxCount 1 ;
            sh:path dcat:resource_identifier ],
        [ sh:datatype <xsd:string> ;
            sh:path <http://dbpedia.org/ontology/officialSchoolColour> ],
        [ sh:datatype <xsd:integer> ;
            sh:path <http://dbpedia.org/ontology/numberOfStudents> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/Location> ] [ sh:class <http://dbpedia.org/ontology/Place> ] ) ;
            sh:path <http://dbpedia.org/ontology/city> ] ;
    sh:targetClass <http://dbpedia.org/ontology/University> .

