            sh:path wdt:P460 ],
        [ sh:maxCount 1 ;
            sh:name "named after"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P138 ],
        [ sh:name "health specialty"@en ;
            sh:or ( [ sh:class wd:Q930752 ] [ sh:class wd:Q44597158 ] ) ;
            sh:path wdt:P1995 ],
        [ sh:class wd:Q103812529 ;
            sh:name "afflicts"@en ;
            sh:path wdt:P689 ],
        [ sh:name "medical examination"@en ;
            sh:or ( [ sh:class wd:Q177719 ] [ sh:class wd:Q2671652 ] ) ;
            sh:path wdt:P923 ],
        [ sh:name "possible treatment"@en ;
            sh:or ( [ sh:class wdt:Q130705900 ] [ sh:class wd:Q179661 ] ) ;
            sh:path wdt:P924 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "time of discovery or invention"@en ;
            sh:path wdt:P575 ],
        [ sh:maxCount 1 ;
            sh:name "facet of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1269 ],
        [ sh:class wd:Q113145171 ;
            sh:name "drug or therapy used for treatment"@en ;
            sh:path wdt:P2176 ],
        [ sh:class wd:Q1662340 ;
            sh:name "disease transmission process"@en ;
            sh:path wdt:P1060 ],
        [ sh:maxCount 1 ;
            sh:name "part of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P361 ],
        [ sh:class wd:Q7187 ;
            sh:maxCount 1 ;
            sh:name "genetic association"@en ;
            sh:path wdt:P2293 ],
        [ sh:maxCount 1 ;
            sh:name "studied by"@en ;
            sh:or ( [ sh:class wd:Q11862829 ] [ sh:class wd:Q1047113 ] ) ;
            sh:path wdt:P2579 ],
        [ sh:class wd:Q3331189 ;
            sh:name "described by source"@en ;
            sh:path wdt:P1343 ],
        [ sh:name "has effect"@en ;
            sh:or ( [ sh:class wd:Q112965645 ] [ sh:class wd:Q12136 ] ) ;
            sh:path wdt:P1542 ],
        [ sh:class wd:Q16695773 ;
            sh:maxCount 1 ;
            sh:name "on focus list of Wikimedia project"@en ;
            sh:path wdt:P5008 ],
        [ sh:class wd:Q5 ;
            sh:name "discoverer or inventor"@en ;
            sh:path wdt:P61 ],
        [ sh:maxCount 1 ;
            sh:name "anatomical location"@en ;
            sh:or ( [ sh:class wd:Q112826905 ] [ sh:class wd:Q103812529 ] ) ;
            sh:path wdt:P927 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:class wd:Q12136 ;
            sh:maxCount 1 ;
            sh:name "opposite of"@en ;
            sh:path wdt:P461 ],
        [ sh:maxCount 1 ;
            sh:name "WordLift URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P6363 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
