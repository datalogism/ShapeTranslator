        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "start time"@en ;
            sh:path wdt:P580 ],
        [ sh:maxCount 1 ;
            sh:name "uses"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P2283 ],
        [ sh:name "participant"@en ;
            sh:or ( [ sh:class wd:Q5 ] [ sh:class wd:Q4438121 ] ) ;
            sh:path wdt:P710 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:name "participating team"@en ;
            sh:or ( [ sh:class wd:Q847017 ] [ sh:class wd:Q12973014 ] ) ;
            sh:path wdt:P1923 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "number of participants"@en ;
            sh:path wdt:P1132 ],
        [ sh:class wd:Q16510064 ;
            sh:maxCount 1 ;
            sh:name "follows"@en ;
