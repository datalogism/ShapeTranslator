@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://shaclshapes.org/buildingShape> a sh:NodeShape ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/buildingEndDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/cuisine> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/owner> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/floorArea> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/headChef> ],
        [ sh:class <http://dbpedia.org/ontology/Building> ;
            sh:path rdf:type ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/architect> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/seatingCapacity> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/floorCount> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/address> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/alternativeName> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/buildingStartDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/location> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/architecturalStyle> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/formerName> ],
        [ sh:nodeKind sh:IRI ;
            sh:path dcat:resource_identifier ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/status> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/cost> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/type> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/developer> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/height> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/elevatorCount> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:name ] ;
    sh:targetClass <http://dbpedia.org/ontology/Building> .

