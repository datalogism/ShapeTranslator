@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbt: <http://dbpedia.org/datatype/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:MusicalWorkShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:double ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:runtime ];
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:musicType ],
        [ sh:class dbo:Award ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:award ],
        [ sh:class dbo:Agent ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:artist ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:starring ],
        [ sh:class dbo:MusicalArtist ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:associatedMusicalArtist ],
        [ sh:class dbo:Band ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:associatedBand ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:composer ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:musicComposer ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:musicBy ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:lyrics ],
        [ sh:datatype rdfs:Literal ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:name ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:writer ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:author ],
        [ sh:class dbo:Agent ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:producer ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:director ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:cinematography ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:editing ],
        [ sh:class dbo:Organisation ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:recordLabel ],
        [ sh:class dbo:Agent ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:distributor ],
        [ sh:class dbo:Company ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:productionCompany ],
        [ sh:class dbo:Album ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:album ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:subtitle ],
        [ sh:class dbo:PopulatedPlace ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:recordedIn ],
        [ sh:class dbo:Sound ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:soundRecording ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:bSide ],
        [ sh:maxCount 1 ;
            sh:node shapes:budgetValueShape ;
            sh:path dbo:budget ],
        [ sh:class dbo:Country ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:country ],
        [ sh:class dbo:Language ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:language ],
        [ sh:class dbo:Work ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:previousWork ],
        [ sh:class dbo:Work ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:subsequentWork ],
        [ sh:path dbo:basedOn ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:imdbId ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:recordDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:releaseDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:publicationDate ],
        [ sh:class dbo:Genre ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:genre ] ;
    sh:targetClass dbo:MusicalWork .

shapes:budgetValueShape a sh:NodeShape ;
    sh:or ( [ sh:datatype dbt:usDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:poundSterling ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:euro ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:canadianDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:japaneseYen ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:russianRouble ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:sriLankanRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:croatianKuna ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:jordanianDinar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:southAfricanRand ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:philippinePeso ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:indianRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:renminbi ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:netherlandsAntilleanGuilder ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:pakistaniRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:malaysianRinggit ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:nepaleseRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:unitedArabEmiratesDirham ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:lebanesePound ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:peruvianNuevoSol ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:hungarianForint ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:swedishKrona ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:danishKrone ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:thaiBaht ;
                sh:nodeKind sh:Literal ] ) .

