        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "local dialing code"@en ;
            sh:path wdt:P473 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
