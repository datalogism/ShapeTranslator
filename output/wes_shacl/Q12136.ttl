@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/DiseaseShape> a sh:NodeShape ;
    rdfs:label "disease"@en ;
    sh:name "disease"@en ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "prevalence"@en ;
            sh:path wdt:P1193 ],
        [ sh:class wd:Q639907 ;
            sh:name "possible medical findings"@en ;
            sh:path wdt:P5131 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "ICD-9-CM"@en ;
            sh:path wdt:P1692 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "ICPC 2 ID"@en ;
            sh:path wdt:P667 ],
        [ sh:name "risk factor"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P5642 ],
        [ sh:name "exact match"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P2888 ],
        [ sh:maxCount 1 ;
            sh:name "external data available at URL"@en ;
            sh:nodeKind sh:IRI ;
