@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbt: <http://dbpedia.org/datatype/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:MeanOfTransportationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:double ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:width ],
        [ sh:datatype xsd:double ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:wheelbase ],
        [ sh:datatype xsd:double ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:weight ],
        [ sh:datatype xsd:double ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:length ],
        [ sh:datatype xsd:double ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:height ];
    sh:property [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:alternativeName ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:completionDate ],
        [ sh:datatype xsd:date ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:acquirementDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:captureDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsStartDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsEndDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:retired ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:shipLaunch ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:maidenVoyage ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:maidenFlight ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:finalFlight ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:motto ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:productionStartYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:productionEndYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:modelStartYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:modelEndYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsStartYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsEndYear ],
        [ sh:datatype xsd:gYear ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:yearOfConstruction ],
        [ sh:class dbo:Country ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:country ],
        [ sh:class dbo:Country ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:countryOrigin ],
        [ sh:class dbo:PopulatedPlace ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:origin ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:homeport ],
        [ sh:class dbo:Building ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:launchSite ],
        [ sh:class dbo:Agent ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:owner ],
        [ sh:class dbo:Agent ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:designer ],
        [ sh:class dbo:Company ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:designCompany ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:numberBuilt ],
        [ sh:maxCount 1 ;
            sh:node shapes:costValueShape ;
            sh:path dbo:cost ],
        [ sh:maxCount 1 ;
            sh:node shapes:costValueShape ;
            sh:path dbo:unitCost ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:totalLaunches ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:failedLaunches ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:rocketStages ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:diameter ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:commissioningDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:decommissioningDate ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:shipBeam ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:shipDraft ],
        [ sh:datatype xsd:double ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:shipDisplacement ],
        [ sh:class dbo:Automobile ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:automobilePlatform ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:recommissioningDate ],
        [ sh:datatype xsd:positiveInteger ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:numberOfDoors ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:cylinderCount ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:transmission ],
        [ sh:class dbo:AutomobileEngine ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:engine ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:orderDate ],
        [ sh:class dbo:Battery ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:battery ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:topSpeed ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:capacity ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:status ],
        [ sh:class dbo:MeanOfTransportation ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:relatedMeanOfTransportation ],
        [ sh:class dbo:Rocket ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:comparable ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:layingDown ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ] ;
    sh:targetClass dbo:MeanOfTransportation .

shapes:costValueShape a sh:NodeShape ;
    sh:or ( [ sh:datatype dbt:usDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:poundSterling ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:euro ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:japaneseYen ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:canadianDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:swedishKrona ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:norwegianKrone ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:danishKrone ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:swissFranc ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:australianDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:malaysianRinggit ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:russianRouble ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:indonesianRupiah ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:polishZ%C5%82oty ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:unitedArabEmiratesDirham ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:renminbi ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:czechKoruna ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:indianRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:bulgarianLev ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:sriLankanRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:hungarianForint ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:southKoreanWon ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:lithuanianLitas ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:croatianKuna ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:iraqiDinar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:mexicanPeso ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:saudiRiyal ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:turkishLira ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:estonianKroon ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:hongKongDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:newTaiwanDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:thaiBaht ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:pakistaniRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:slovakKoruna ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:chileanPeso ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:kuwaitiDinar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:newZealandDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:bangladeshiTaka ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:philippinePeso ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:serbianDinar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:brazilianReal ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:tanzanianShilling ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:georgianLari ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:algerianDinar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:armenianDram ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:colombianPeso ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:argentinePeso ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:israeliNewSheqel ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:moroccanDirham ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:egyptianPound ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:lebanesePound ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:iranianRial ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:capeVerdeEscudo ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:kenyanShilling ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:ugandaShilling ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:bruneiDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:cambodianRiel ;
                sh:nodeKind sh:Literal ] ) .

