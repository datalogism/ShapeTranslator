@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/EmbassyShape> a sh:NodeShape ;
    rdfs:label "embassy"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:datatype rdf:langString ;
            sh:name "native label"@en ;
            sh:path wdt:P1705 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "inception"@en ;
            sh:path wdt:P571 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "fax number"@en ;
            sh:path wdt:P2900 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "dissolved, abolished or demolished date"@en ;
            sh:path wdt:P576 ],
        [ sh:class wd:Q43229 ;
            sh:name "child organization or unit"@en ;
            sh:path wdt:P355 ],
        [ sh:class wd:Q6256 ;
            sh:name "operating area"@en ;
            sh:path wdt:P2541 ],
        [ sh:class wd:Q56061 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "located in the administrative territorial entity"@en ;
            sh:path wdt:P131 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:class wd:Q10541491 ;
            sh:maxCount 1 ;
            sh:name "legal form"@en ;
            sh:path wdt:P1454 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:maxCount 1 ;
            sh:name "parent organization or unit"@en ;
            sh:or ( [ sh:class wd:Q20901295 ] [ sh:class wd:Q14037025 ] ) ;
            sh:path wdt:P749 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "operator"@en ;
            sh:path wdt:P137 ],
        [ sh:maxCount 1 ;
            sh:name "described at URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P973 ],
        [ sh:class wd:Q5 ;
            sh:name "chairperson"@en ;
            sh:path wdt:P488 ],
        [ sh:class wd:Q515 ;
            sh:maxCount 1 ;
            sh:name "location"@en ;
            sh:path wdt:P276 ],
        [ sh:class wd:Q213283 ;
            sh:maxCount 1 ;
            sh:name "replaces"@en ;
            sh:path wdt:P1365 ],
        [ sh:datatype xsd:string ;
            sh:name "phone number"@en ;
            sh:path wdt:P1329 ],
        [ sh:maxCount 1 ;
            sh:name "email address"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P968 ],
        [ sh:class wd:Q8187769 ;
            sh:maxCount 1 ;
            sh:name "industry"@en ;
            sh:path wdt:P452 ],
        [ sh:datatype rdf:langString ;
            sh:name "official name"@en ;
            sh:path wdt:P1448 ],
        [ sh:class wd:Q15221623 ;
            sh:maxCount 1 ;
            sh:name "field of work"@en ;
            sh:path wdt:P101 ],
        [ sh:class wd:Q16695773 ;
            sh:maxCount 1 ;
            sh:name "on focus list of Wikimedia project"@en ;
            sh:path wdt:P5008 ],
        [ sh:class wd:Q4164871 ;
            sh:maxCount 1 ;
            sh:name "position held by head of the organization"@en ;
            sh:path wdt:P2388 ],
        [ sh:class wd:Q5 ;
            sh:maxCount 1 ;
            sh:name "director / manager"@en ;
            sh:path wdt:P1037 ],
        [ sh:maxCount 1 ;
            sh:name "part of"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P361 ],
        [ sh:maxCount 1 ;
            sh:name "official website"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P856 ],
        [ sh:class wd:Q3917681 ;
            sh:maxCount 1 ;
            sh:name "opposite of"@en ;
            sh:path wdt:P461 ],
        [ sh:name "significant event"@en ;
            sh:or ( [ sh:class wd:Q1914636 ] [ sh:class wd:Q1190554 ] ) ;
            sh:path wdt:P793 ],
        [ sh:class wd:Q15221623 ;
            sh:maxCount 1 ;
            sh:name "facet of"@en ;
            sh:path wdt:P1269 ],
        [ sh:class wd:Q3917681 ;
            sh:name "replaced by"@en ;
            sh:path wdt:P1366 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "social media followers"@en ;
            sh:path wdt:P8687 ],
        [ sh:class wd:Q6256 ;
            sh:minCount 1 ;
            sh:name "applies to jurisdiction"@en ;
            sh:path wdt:P1001 ],
        [ sh:name "has part(s)"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P527 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ] ;
    sh:targetClass wd:Q3917681 .

