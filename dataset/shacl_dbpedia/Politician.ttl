@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:PoliticianShape a sh:NodeShape ;
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:path dbo:award ],
        [ sh:class dbo:Country ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:nationality ],
        [ sh:class dbo:PersonFunction ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:occupation ],
        [ sh:minCount 1 ;
            sh:or ( [ sh:class dbo:PersonFunction ] [ sh:class dbo:Profession ] ) ;
            sh:path dbo:profession ],
        [ sh:minCount 1 ;
            sh:path dbo:education ],
        [ sh:class dbo:TimePeriod ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:termPeriod ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:deathDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsStartDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsEndDate ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:serviceStartYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:serviceEndYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:deathYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsStartYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:activeYearsEndYear ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:originalName ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:alias ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:class dbo:Country ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:stateOfOrigin ],
        [ sh:class dbo:Country ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:country ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:birthPlace ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:deathPlace ],
        [ sh:class dbo:Place ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:residence ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:restingPlace ],
        [ sh:class dbo:Place ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:region ],
        [ sh:class dbo:Sound ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:soundRecording ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:signature ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:religion ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:knownFor ],
        [ sh:class dbo:EducationalInstitution ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:almaMater ],
        [ sh:class dbo:MilitaryRank ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:militaryRank ],
        [ sh:class dbo:MilitaryService ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:militaryService ],
        [ sh:class dbo:MilitaryUnit ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:militaryBranch ],
        [ sh:class dbo:MilitaryUnit ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:militaryUnit ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:militaryCommand ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:father ],
        [ sh:class dbo:Person ;
            sh:maxCount 2 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:parent ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:relative ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:spouse ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:relation ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:child ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:partner ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:mother ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:associate ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:height ],
        [ sh:class dbo:SocietalEvent ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:battle ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:lieutenant ],
        [ sh:class dbo:Politician ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:president ],
        [ sh:class dbo:Politician ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:primeMinister ],
        [ sh:class dbo:Royalty ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:monarch ],
        [ sh:class dbo:Politician ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:governor ],
        [ sh:class dbo:Politician ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:vicePresident ],
        [ sh:class dbo:Politician ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:deputy ],
        [ sh:class dbo:Politician ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:appointer ],
        [ sh:class dbo:Politician ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:chancellor ],
        [ sh:class dbo:Politician ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:governorGeneral ],
        [ sh:class dbo:PoliticalParty ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:otherParty ],
        [ sh:class dbo:PoliticalParty ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:party ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:electionMajority ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:office ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:orderInOffice ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:committee ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:portfolio ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:seniority ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:imdbId ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path foaf:name ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthName ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dbo:birthYear ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:deathCause ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ] ;
    sh:targetClass dbo:Politician .

