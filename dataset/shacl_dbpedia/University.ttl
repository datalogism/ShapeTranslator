@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbt: <http://dbpedia.org/datatype/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:UniversityShape a sh:NodeShape ;
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:foundingDate ],
        [ sh:class dbo:City ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:city ],
        [ sh:class dbo:PopulatedPlace ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:state ],
        [ sh:class dbo:Country ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:country ],
        [ sh:class dbo:Place ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:campus ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:numberOfStudents ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:numberOfUndergraduateStudents ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path foaf:name ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:numberOfPostgraduateStudents ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:numberOfDoctoralStudents ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:facultySize ],
        [ sh:maxCount 1 ;
            sh:node shapes:CostUnitShape ;
            sh:path dbo:endowment ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:president ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:chancellor ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:viceChancellor ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:rector ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:dean ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:provost ],
        [ sh:datatype rdf:langString ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:formerName ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:principal ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:head ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:chairman ],
        [ sh:class dbo:Person ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:director ],
        [ sh:class dbo:PersonFunction ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:leaderFunction ],
        [ sh:class dbo:Organisation ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:affiliation ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:datatype xsd:string ;
            sh:path foaf:nick ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:motto ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:mascot ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:officialSchoolColour ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ] ;
    sh:targetClass dbo:University .

shapes:CostUnitShape a sh:NodeShape ;
    sh:or ( [ sh:datatype dbt:usDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:poundSterling ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:euro ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:canadianDollar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:japaneseYen ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:russianRouble ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:sriLankanRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:croatianKuna ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:jordanianDinar ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:southAfricanRand ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:philippinePeso ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:indianRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:renminbi ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:netherlandsAntilleanGuilder ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:pakistaniRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:malaysianRinggit ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:nepaleseRupee ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:unitedArabEmiratesDirham ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:lebanesePound ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:peruvianNuevoSol ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:hungarianForint ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:swedishKrona ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:danishKrone ;
                sh:nodeKind sh:Literal ] [ sh:datatype dbt:thaiBaht ;
                sh:nodeKind sh:Literal ] ) .

