@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://shaclshapes.org/athleteShape> a sh:NodeShape ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/draftTeam> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/draftPick> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/formerTeam> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/draftYear> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/debutTeam> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/position> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/bowlingSide> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/birthYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/deathYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/award> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/deathPlace> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:name ],
        [ sh:class <http://dbpedia.org/ontology/EducationalInstitution> ;
            sh:path <http://dbpedia.org/ontology/highschool> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/birthPlace> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/careerStation> ],
        [ sh:class <http://dbpedia.org/ontology/Athlete> ;
            sh:path rdf:type ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/team> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/undraftedYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/status> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/activeYearsStartYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/draftRound> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/number> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/battingSide> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/deathDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/league> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:nick ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/nationality> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/birthDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/height> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/activeYearsEndYear> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/weight> ],
        [ sh:nodeKind sh:IRI ;
            sh:path dcat:resource_identifier ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/college> ] ;
    sh:targetClass <http://dbpedia.org/ontology/Athlete> .

