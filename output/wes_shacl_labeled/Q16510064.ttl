@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/SportingEventShape> a sh:NodeShape ;
    rdfs:label "sporting event"@en ;
    sh:property [ sh:class wd:Q5 ;
            sh:maxCount 1 ;
            sh:name "pole position"@en ;
            sh:path wdt:P3764 ],
        [ sh:class wd:Q1076486 ;
            sh:maxCount 1 ;
            sh:name "home venue"@en ;
            sh:path wdt:P115 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "point in time"@en ;
            sh:path wdt:P585 ],
        [ sh:class wd:Q5 ;
            sh:name "significant person"@en ;
            sh:path wdt:P3342 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "end time"@en ;
            sh:path wdt:P582 ],
        [ sh:class wd:Q5 ;
            sh:maxCount 1 ;
            sh:name "fastest lap"@en ;
            sh:path wdt:P5053 ],
        [ sh:class wd:Q11266439 ;
            sh:maxCount 1 ;
            sh:name "topic has template"@en ;
            sh:path wdt:P1424 ],
        [ sh:class wd:Q56061 ;
