@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/AstronautShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/Astronaut> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/OrganizationShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/Organisation> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/astronautShape> a sh:NodeShape ;
    sh:property [ sh:path <http://dbpedia.org/ontology/selection> ],
        [ sh:path <http://dbpedia.org/ontology/occupation> ],
        [ sh:datatype <rdf:langString> ;
            sh:path <http://dbpedia.org/ontology/birthName> ],
        [ sh:path <http://dbpedia.org/ontology/mission> ],
        [ sh:path <http://dbpedia.org/ontology/birthPlace> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/almaMater> ],
        [ sh:datatype <xsd:integer> ;
            sh:path <http://dbpedia.org/ontology/deathYear> ],
        [ sh:datatype <xsd:integer> ;
            sh:maxCount 2 ;
            sh:path <http://dbpedia.org/ontology/birthYear> ],
        [ sh:datatype <xsd:date> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/deathDate> ],
        [ sh:path <http://dbpedia.org/ontology/deathPlace> ],
        [ sh:datatype <xsd:double> ;
            sh:path dcat:resource_identifier ],
        [ sh:datatype <xsd:double> ;
            sh:path <http://dbpedia.org/ontology/timeInSpace> ],
        [ sh:path <http://dbpedia.org/ontology/nationality> ],
        [ sh:path <http://dbpedia.org/ontology/award> ],
        [ sh:class <http://dbpedia.org/ontology/Astronaut> ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:date> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/birthDate> ],
        [ sh:datatype <rdf:langString> ;
            sh:maxCount 2 ;
            sh:path foaf:name ],
        [ sh:datatype <xsd:string> ;
            sh:path <http://dbpedia.org/ontology/status> ] ;
    sh:targetClass <http://dbpedia.org/ontology/Astronaut> .

