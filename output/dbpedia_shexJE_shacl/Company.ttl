@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/CompanyShape> a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path <http://dbpedia.org/ontology/openingYear> ] ] [ sh:property [ sh:maxCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path <http://dbpedia.org/ontology/foundingYear> ] ] ) ;
    sh:property [ sh:node <http://shaclshapes.org/CurrencyDTShape> ;
            sh:path <http://dbpedia.org/ontology/assetUnderManagement> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/numberOfLocations> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/fate> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/leader> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/headquarter> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/originalName> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageRedirects> ;
            sh:pattern "^http://dbpedia.org/resource/" ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageLength> ],
        [ sh:class <http://dbpedia.org/ontology/Company> ;
            sh:path <http://dbpedia.org/ontology/owningCompany> ],
        [ sh:nodeKind sh:Literal ;
            sh:path owl:sameAs ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/numberOfLawyers> ],
        [ sh:class <http://dbpedia.org/ontology/Company> ;
            sh:path <http://dbpedia.org/ontology/subsidiary> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageExternalLink> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/keyPerson> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageWikiLink> ;
            sh:pattern "^http://dbpedia.org/resource/" ],
        [ sh:maxCount 1 ;
            sh:node <http://shaclshapes.org/CurrencyDTShape> ;
            sh:path <http://dbpedia.org/ontology/equity> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/production> ],
        [ sh:nodeKind sh:Literal ;
            sh:path prov:wasDerivedFrom ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/revenueYear> ],
        [ sh:maxCount 1 ;
            sh:node <http://shaclshapes.org/CurrencyDTShape> ;
            sh:path <http://dbpedia.org/ontology/operatingIncome> ],
        [ sh:class <http://dbpedia.org/ontology/Agent> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/owner> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageRevisionID> ],
        [ sh:class <http://dbpedia.org/ontology/Company> ;
            sh:path <http://dbpedia.org/ontology/distributingCompany> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/slogan> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/regionServed> ],
        [ sh:class <http://dbpedia.org/ontology/Image> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/thumbnail> ],
        [ sh:datatype xsd:date ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( <http://dbpedia.org/ontology/foundingDate> <http://dbpedia.org/ontology/formationDate> <http://dbpedia.org/ontology/openingDate> ) ] ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/reportingMark> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/numberOfEmployees> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/formerName> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/closingYear> ],
        [ sh:class <http://dbpedia.org/ontology/Company> ;
            sh:path <http://dbpedia.org/ontology/parentCompany> ],
        [ sh:class <http://dbpedia.org/ontology/Agent> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/foundedBy> ],
        [ sh:maxCount 1 ;
            sh:node <http://shaclshapes.org/CurrencyDTShape> ;
            sh:path <http://dbpedia.org/ontology/netIncome> ],
        [ sh:class skos:Concept ;
            sh:path dcterms:subject ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/location> ],
        [ sh:nodeKind sh:Literal ;
            sh:path foaf:isPrimaryTopicOf ],
        [ sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:name ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageID> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/foundationPlace> ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/locationCountry> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/abstract> ],
        [ sh:maxCount 1 ;
            sh:node <http://shaclshapes.org/CurrencyDTShape> ;
            sh:path <http://dbpedia.org/ontology/revenue> ],
        [ sh:node <http://shaclshapes.org/CurrencyDTShape> ;
            sh:path <http://dbpedia.org/ontology/assets> ],
        [ sh:class <http://dbpedia.org/ontology/Image> ;
            sh:minCount 1 ;
            sh:path foaf:depiction ] ;
    sh:targetClass <http://dbpedia.org/ontology/Company> .

