@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/WrittenWorkShape> a sh:NodeShape ;
    sh:property [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/numberOfPages> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageInterLanguageLink> ;
            sh:pattern "^http://dbpedia.org/resource/" ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/releaseDate> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/foundingDate> ],
        [ sh:class <http://dbpedia.org/ontology/Work> ;
            sh:path <http://dbpedia.org/ontology/subsequentWork> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/coverArtist> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/premiereYear> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/translator> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageRevisionID> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/coden> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/Media> ] [ sh:class <http://dbpedia.org/ontology/Website> ] [ sh:class <http://dbpedia.org/ontology/Work> ] ) ;
            sh:path <http://dbpedia.org/ontology/format> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/issn> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/editorTitle> ],
        [ sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/settingOfPlay> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageExternalLink> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/logo> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/chiefEditor> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/firstPublicationYear> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/illustrator> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/jstor> ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:class <http://dbpedia.org/ontology/Agent> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/publisher> ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path foaf:name ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:class <http://dbpedia.org/ontology/Agent> ;
            sh:path <http://dbpedia.org/ontology/owner> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path [ sh:alternativePath ( <http://dbpedia.org/ontology/literaryGenre> <http://dbpedia.org/ontology/genre> ) ] ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/frequencyOfPublication> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/oclc> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/firstPublicationDate> ],
        [ sh:minCount 1 ;
            sh:or ( [ sh:class <http://dbpedia.org/ontology/Artwork> ] [ sh:class <http://dbpedia.org/ontology/Device> ] [ sh:class <http://dbpedia.org/ontology/InformationAppliance> ] [ sh:class <http://dbpedia.org/ontology/Newspaper> ] [ sh:class <http://dbpedia.org/ontology/ProgrammingLanguage> ] [ sh:class <http://dbpedia.org/ontology/Software> ] [ sh:class <http://dbpedia.org/ontology/Work> ] ) ;
            sh:path <http://dbpedia.org/ontology/mediaType> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/isbn> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/lccn> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/writer> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageRedirects> ;
            sh:pattern "^http://dbpedia.org/resource/" ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/imageSize> ],
        [ sh:class skos:Concept ;
            sh:path dcterms:subject ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/location> ],
        [ sh:class <http://dbpedia.org/ontology/Work> ;
            sh:path <http://dbpedia.org/ontology/previousWork> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/publicationDate> ],
        [ sh:or ( [ sh:class <http://dbpedia.org/ontology/AcademicSubject> ] [ sh:class <http://dbpedia.org/ontology/MedicalSpecialty> ] ) ;
            sh:path <http://dbpedia.org/ontology/academicDiscipline> ],
        [ sh:class <http://dbpedia.org/ontology/Venue> ;
            sh:path <http://dbpedia.org/ontology/premierePlace> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/depictionDescription> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/impactFactor> ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/city> ],
        [ sh:class <http://dbpedia.org/ontology/Newspaper> ;
            sh:path <http://dbpedia.org/ontology/sisterNewspaper> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/previousEditor> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/characterInPlay> ],
        [ sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/subjectOfPlay> ],
        [ sh:class <http://dbpedia.org/ontology/Magazine> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/magazine> ],
        [ sh:class <http://dbpedia.org/ontology/Language> ;
            sh:maxCount 1 ;
            sh:path <http://dbpedia.org/ontology/originalLanguage> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/circulation> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/author> ],
        [ sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/license> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/finalPublicationYear> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/lcc> ],
        [ sh:class <http://dbpedia.org/ontology/Language> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/language> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/lastPublicationDate> ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/numberOfVolumes> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/abstract> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/premiereDate> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/dcc> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/wikiPageID> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/formerName> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/imdbId> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/openAccessContent> ],
        [ sh:nodeKind sh:IRI ;
            sh:path <http://dbpedia.org/ontology/nonFictionSubject> ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path <http://dbpedia.org/ontology/abbreviation> ],
        [ sh:class <http://dbpedia.org/ontology/Image> ;
            sh:minCount 1 ;
            sh:path foaf:depiction ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/editor> ],
        [ sh:class <http://dbpedia.org/ontology/Work> ;
            sh:path <http://dbpedia.org/ontology/series> ],
        [ sh:class <http://dbpedia.org/ontology/Image> ;
            sh:minCount 1 ;
            sh:path <http://dbpedia.org/ontology/thumbnail> ],
        [ sh:nodeKind sh:Literal ;
            sh:path owl:sameAs ] ;
    sh:targetClass <http://dbpedia.org/ontology/WrittenWork> .

