            sh:path wdt:P495 ],
        [ sh:class wd:Q4167836 ;
            sh:maxCount 1 ;
            sh:name "topic's main category"@en ;
            sh:path wdt:P910 ],
        [ sh:class wd:Q9143 ;
            sh:name "programmed in"@en ;
            sh:path wdt:P277 ],
        [ sh:name "official website"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P856 ],
        [ sh:datatype rdf:langString ;
            sh:name "motto text"@en ;
            sh:path wdt:P1451 ],
        [ sh:class wd:Q9135 ;
            sh:name "operating system"@en ;
            sh:path wdt:P306 ],
        [ sh:name "different from"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1889 ],
        [ sh:name "official blog URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P1581 ],
        [ sh:class wd:Q50424085 ;
            sh:maxCount 1 ;
            sh:name "copyright status"@en ;
            sh:path wdt:P6216 ],
        [ sh:name "described by source"@en ;
            sh:or ( [ sh:class wd:Q386724 ] [ sh:class wd:Q13442814 ] ) ;
            sh:path wdt:P1343 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "software version identifier"@en ;
            sh:path wdt:P348 ],
        [ sh:name "developer"@en ;
            sh:or ( [ sh:class wd:Q5 ] [ sh:class wd:Q43229 ] [ sh:class wd:Q18388277 ] ) ;
            sh:path wdt:P178 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "Commons category"@en ;
            sh:path wdt:P373 ],
        [ sh:datatype xsd:decimal ;
            sh:name "social media followers"@en ;
            sh:path wdt:P8687 ],
        [ sh:maxCount 1 ;
            sh:name "maintained by"@en ;
            sh:or ( [ sh:class wd:Q4830453 ] [ sh:class wd:Q43229 ] ) ;
            sh:path wdt:P126 ],
        [ sh:name "founder"@en ;
            sh:or ( [ sh:class wd:Q5 ] [ sh:class wd:Q4830453 ] [ sh:class wd:Q43229 ] ) ;
            sh:path wdt:P112 ],
        [ sh:class wd:Q1288568 ;
            sh:name "language of work or name"@en ;
            sh:path wdt:P407 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "dissolved, abolished or demolished date"@en ;
            sh:path wdt:P576 ],
        [ sh:class wd:Q77205602 ;
            sh:name "copyright license"@en ;
            sh:path wdt:P275 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "search formatter URL"@en ;
            sh:path wdt:P4354 ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "inception"@en ;
            sh:path wdt:P571 ],
        [ sh:name "uses"@en ;
