@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:WrittenWorkShape a sh:NodeShape ;
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:dcc ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:coden ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:depictionDescription ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path [ sh:alternativePath ( dbo:literaryGenre dbo:genre ) ] ],
        [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class dbo:AcademicSubject ] [ sh:class dbo:MedicalSpecialty ] ) ;
            sh:path dbo:academicDiscipline ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path foaf:name ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:nonFictionSubject ],
        [ sh:class dbo:Person ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:author ],
        [ sh:class dbo:Person ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:writer ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:translator ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:editor ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:chiefEditor ],
        [ sh:datatype xsd:string ;
            sh:path dbo:formerName ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:previousEditor ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:editorTitle ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:illustrator ],
        [ sh:class dbo:Person ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:coverArtist ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:publicationDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:releaseDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:firstPublicationDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:lastPublicationDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:foundingDate ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:firstPublicationYear ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:abbreviation ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:finalPublicationYear ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:premiereDate ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:premiereYear ],
        [ sh:class dbo:Venue ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:premierePlace ],
        [ sh:class dbo:Agent ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:publisher ],
        [ sh:class dbo:Agent ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:owner ],
        [ sh:datatype xsd:positiveInteger ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:numberOfPages ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:numberOfVolumes ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:circulation ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:impactFactor ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:isbn ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:frequencyOfPublication ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:openAccessContent ],
        [ sh:class dbo:City ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:city ],
        [ sh:class dbo:Country ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:country ],
        [ sh:class dbo:Language ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:language ],
        [ sh:class dbo:Language ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:originalLanguage ],
        [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class dbo:Media ] [ sh:class dbo:Work ] [ sh:class dbo:Website ] ) ;
            sh:path dbo:format ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:issn ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class dbo:InformationAppliance ] [ sh:class dbo:Device ] [ sh:class dbo:Work ] [ sh:class dbo:Software ] [ sh:class dbo:ProgrammingLanguage ] [ sh:class dbo:Newspaper ] [ sh:class dbo:Artwork ] ) ;
            sh:path dbo:mediaType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:oclc ],
        [ sh:nodeKind sh:IRI ;
            sh:path dbo:license ],
        [ sh:class dbo:Work ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:series ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:lcc ],
        [ sh:class dbo:Work ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:previousWork ],
        [ sh:class dbo:Work ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:subsequentWork ],
        [ sh:class dbo:Magazine ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:magazine ],
        [ sh:class dbo:Newspaper ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:sisterNewspaper ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:settingOfPlay ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:characterInPlay ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:subjectOfPlay ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:logo ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:imageSize ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:lccn ],
        [ sh:nodeKind sh:IRI ;
            sh:path foaf:homepage ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:imdbId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:jstor ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path owl:differentFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ] ;
    sh:targetClass dbo:WrittenWork .

