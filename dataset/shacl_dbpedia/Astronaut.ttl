@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:AstronautShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:double ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:Literal ;
                        sh:path dbo:timeInSpace ];
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:deathPlace ],
        [ sh:class dbo:Country ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:nationality ],
        [ sh:class dbo:PersonFunction ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:occupation ],
        [ sh:class dbo:Award ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:award ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:status ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:selection ],
        [ sh:class dbo:SpaceMission ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:mission ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path foaf:name ],
        [ sh:class dbo:EducationalInstitution ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:almaMater ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthName ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:birthDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:deathDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dbo:retired ],
        [ sh:class dbo:Place ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:birthPlace ] ;
    sh:targetClass dbo:Astronaut .

