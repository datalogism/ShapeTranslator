PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX yago: <http://yago-knowledge.org/resource/>

start = @<Company>

<Company> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Company> ] ;
  rdfs:label rdf:langString + ;
  <http://dbpedia.org/ontology/foundingYear> xsd:gYear ;
  <http://dbpedia.org/ontology/closingYear> xsd:gYear ? ;
  <http://dbpedia.org/ontology/revenueYear> xsd:gYear ? ;
  <http://xmlns.com/foaf/0.1/name> xsd:string + ;
  <http://dbpedia.org/ontology/location> @<Place> + ;
  <http://dbpedia.org/ontology/originalName> rdf:langString * ;
  <http://dbpedia.org/ontology/headquarter> @<Place> + ;
  <http://dbpedia.org/ontology/foundationPlace> @<Place> ? ;
  <http://dbpedia.org/ontology/regionServed> @<Place> * ;
  <http://dbpedia.org/ontology/country> @<Country> + ;
  <http://dbpedia.org/ontology/locationCountry> @<Country> + ;
  <http://dbpedia.org/ontology/locationCity> @<City> + ;
  <http://dbpedia.org/ontology/revenue> @<CurrencyDT> ? ;
  <http://dbpedia.org/ontology/netIncome> @<CurrencyDT> ? ;
  <http://dbpedia.org/ontology/operatingIncome> @<CurrencyDT> ? ;
  <http://dbpedia.org/ontology/assets> @<CurrencyDT> * ;
  <http://dbpedia.org/ontology/formerName> rdf:langString * ;
  <http://dbpedia.org/ontology/equity> @<CurrencyDT> ? ;
  <http://dbpedia.org/ontology/assetUnderManagement> @<CurrencyDT> * ;
  <http://dbpedia.org/ontology/numberOfEmployees> xsd:nonNegativeInteger ;
  <http://dbpedia.org/ontology/numberOfLocations> xsd:nonNegativeInteger ;
  <http://dbpedia.org/ontology/numberOfLawyers> xsd:nonNegativeInteger * ;
  <http://dbpedia.org/ontology/production> xsd:nonNegativeInteger * ;
  <http://dbpedia.org/ontology/slogan> rdf:langString * ;
  <http://dbpedia.org/ontology/fate> rdf:langString * ;
  <http://dbpedia.org/ontology/parentCompany> @<Company_class> * ;
  <http://dbpedia.org/ontology/subsidiary> @<Company_class> * ;
  <http://dbpedia.org/ontology/owningCompany> @<Company_class> * ;
  <http://dbpedia.org/ontology/distributingCompany> @<Company_class> * ;
  <http://dbpedia.org/ontology/foundedBy> @<Agent> + ;
  <http://dbpedia.org/ontology/owner> @<Agent> + ;
  <http://dbpedia.org/ontology/keyPerson> @<Person> * ;
  <http://dbpedia.org/ontology/reportingMark> xsd:string * ;
  owl:differentFrom xsd:anyURI * ;
  <http://dbpedia.org/ontology/wikiPageRevisionID> xsd:integer + ;
  rdfs:comment rdf:langString + ;
  <http://dbpedia.org/ontology/foundingDate> xsd:date + ;
  <http://dbpedia.org/ontology/formationDate> xsd:date + ;
  <http://dbpedia.org/ontology/openingDate> xsd:date + ;
  <http://dbpedia.org/ontology/openingYear> xsd:gYear ? ;
  <http://dbpedia.org/ontology/foundingYear> xsd:gYear ? ;
  <http://dbpedia.org/ontology/openingYear> xsd:gYear ? ;
  <http://dbpedia.org/ontology/foundingYear> xsd:gYear ?
}

<CurrencyDT> <http://dbpedia.org/datatype/usDollar> OR <http://dbpedia.org/datatype/euro> OR <http://dbpedia.org/datatype/poundSterling> OR <http://dbpedia.org/datatype/japaneseYen> OR <http://dbpedia.org/datatype/norwegianKrone> OR <http://dbpedia.org/datatype/renminbi> OR <http://dbpedia.org/datatype/sriLankanRupee> OR <http://dbpedia.org/datatype/swedishKrona> OR <http://dbpedia.org/datatype/swissFranc> OR <http://dbpedia.org/datatype/danishKrone> OR <http://dbpedia.org/datatype/canadianDollar> OR <http://dbpedia.org/datatype/southKoreanWon> OR <http://dbpedia.org/datatype/hongKongDollar> OR <http://dbpedia.org/datatype/philippinePeso> OR <http://dbpedia.org/datatype/australianDollar> OR <http://dbpedia.org/datatype/malaysianRinggit> OR <http://dbpedia.org/datatype/polishZ%C5%82oty> OR <http://dbpedia.org/datatype/indianRupee> OR <http://dbpedia.org/datatype/russianRouble> OR <http://dbpedia.org/datatype/icelandKrona> OR <http://dbpedia.org/datatype/bangladeshiTaka> OR <http://dbpedia.org/datatype/croatianKuna> OR <http://dbpedia.org/datatype/czechKoruna> OR <http://dbpedia.org/datatype/indonesianRupiah> OR <http://dbpedia.org/datatype/kazakhstaniTenge> OR <http://dbpedia.org/datatype/unitedArabEmiratesDirham> OR <http://dbpedia.org/datatype/botswanaPula> OR <http://dbpedia.org/datatype/algerianDinar> OR <http://dbpedia.org/datatype/saudiRiyal> OR <http://dbpedia.org/datatype/hungarianForint> OR <http://dbpedia.org/datatype/myanmaKyat> OR <http://dbpedia.org/datatype/nigerianNaira> OR <http://dbpedia.org/datatype/georgianLari> OR <http://dbpedia.org/datatype/colombianPeso> OR <http://dbpedia.org/datatype/kuwaitiDinar> OR <http://dbpedia.org/datatype/azerbaijaniManat> OR <http://dbpedia.org/datatype/southAfricanRand> OR <http://dbpedia.org/datatype/newTaiwanDollar> OR <http://dbpedia.org/datatype/mexicanPeso> OR <http://dbpedia.org/datatype/albanianLek> OR <http://dbpedia.org/datatype/mauritianRupee> OR <http://dbpedia.org/datatype/qatariRial> OR <http://dbpedia.org/datatype/moroccanDirham> OR <http://dbpedia.org/datatype/egyptianPound> OR <http://dbpedia.org/datatype/jordanianDinar> OR <http://dbpedia.org/datatype/israeliNewSheqel> OR <http://dbpedia.org/datatype/nepaleseRupee> OR <http://dbpedia.org/datatype/maldivianRufiyaa> OR <http://dbpedia.org/datatype/peruvianNuevoSol> OR <http://dbpedia.org/datatype/latvianLats> OR <http://dbpedia.org/datatype/bruneiDollar>

<Agent> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Agent> ]
}

<City> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/City> ]
}

<Company_class> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Company> ]
}

<Country> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Country> ]
}

<Person> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Person> ]
}

<Place> EXTRA rdf:type {
  rdf:type [ <http://dbpedia.org/ontology/Place> ]
}
