@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://shaclshapes.org/PoliticianShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <http://dbpedia.org/ontology/Politician> ;
            sh:path rdf:type ] .

<http://shaclshapes.org/politicianShape> a sh:NodeShape ;
    sh:property [ sh:class <http://dbpedia.org/ontology/Politician> ;
            sh:path rdf:type ],
        [ sh:path foaf:name ],
        [ sh:path <http://dbpedia.org/ontology/termPeriod> ],
        [ sh:path <http://dbpedia.org/ontology/birthPlace> ],
        [ sh:path dcat:resource_identifier ],
        [ sh:path <http://dbpedia.org/ontology/party> ] ;
    sh:targetClass <http://dbpedia.org/ontology/Politician> .

