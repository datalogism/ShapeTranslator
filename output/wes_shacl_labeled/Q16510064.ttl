            sh:path wdt:P1346 ],
        [ sh:name "has part(s)"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P527 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:name "event interval"@en ;
            sh:path wdt:P2257 ],
        [ sh:class wd:Q6256 ;
            sh:maxCount 1 ;
            sh:name "country"@en ;
            sh:path wdt:P17 ],
        [ sh:name "described at URL"@en ;
            sh:nodeKind sh:IRI ;
            sh:path wdt:P973 ],
        [ sh:datatype xsd:decimal ;
